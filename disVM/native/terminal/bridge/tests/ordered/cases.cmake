# RU: Настоящий ordered launch-мост, реальные FlashVM-каналы/wrappers и исходный Styx carrier.
if(INFERNO_UI_HOST_LIBRARIES)
    foreach(ordered_terminal_case RANGE 0 14)
        set(ordered_terminal_peer terminal-ordered-bridge-${ordered_terminal_case})
        add_executable(${ordered_terminal_peer} tests/ordered/host.c tests/ordered/wire.c tests/ordered/fault.c
            ../tests/link/fixture.c ../../tests/file-root/context.c)
        target_compile_definitions(${ordered_terminal_peer} PRIVATE ORDERED_TERMINAL_CASE=${ordered_terminal_case})
        target_compile_options(${ordered_terminal_peer} PRIVATE -Wall -Wextra -Wpedantic -Werror -Wno-unknown-pragmas)
        target_include_directories(${ordered_terminal_peer} PRIVATE "${INFERNO_VFS_SUPPORT}/flashVM/ports")
        set_source_files_properties(tests/ordered/wire.c PROPERTIES INCLUDE_DIRECTORIES "${inferno_headers}")
        if(ordered_terminal_case EQUAL 5)
            target_sources(${ordered_terminal_peer} PRIVATE tests/ordered/as.c)
            set_property(TARGET ${ordered_terminal_peer} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,--wrap=styxorderedclientsendwait")
        elseif(ordered_terminal_case EQUAL 6)
            set_property(TARGET ${ordered_terminal_peer} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,--wrap=styxbidircontrol")
        elseif(ordered_terminal_case EQUAL 7 OR ordered_terminal_case EQUAL 9)
            set_property(TARGET ${ordered_terminal_peer} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,--wrap=styxorderedwatch")
        elseif(ordered_terminal_case EQUAL 10 OR ordered_terminal_case EQUAL 12)
            set_property(TARGET ${ordered_terminal_peer} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,--wrap=styxbidircontrolwatch")
        elseif(ordered_terminal_case EQUAL 13 OR ordered_terminal_case EQUAL 14)
            set_property(TARGET ${ordered_terminal_peer} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,--wrap=pthread_create")
        elseif(ordered_terminal_case EQUAL 11)
            set_property(TARGET ${ordered_terminal_peer} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,--wrap=orderedreceive -Wl,--wrap=styxorderedclientsendwait")
        endif()
        set_target_properties(${ordered_terminal_peer} PROPERTIES LINKER_LANGUAGE CXX)
        target_link_libraries(${ordered_terminal_peer} PRIVATE styx_terminal_bridge infernostyx_phy remote_phy_mux ${INFERNO_UI_HOST_LIBRARIES})
        add_test(NAME ${ordered_terminal_peer} COMMAND ${ordered_terminal_peer})
        set_tests_properties(${ordered_terminal_peer} PROPERTIES TIMEOUT 20)
    endforeach()
endif()

if(INFERNO_UI_HOST_LIBRARIES)
    add_executable(terminal-ordered-bridge-header tests/ordered/header.cc ../../tests/file-root/context.c)
    set_target_properties(terminal-ordered-bridge-header PROPERTIES CXX_STANDARD 98 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
    target_compile_options(terminal-ordered-bridge-header PRIVATE -Wall -Wextra -Wpedantic -Werror -Wno-long-long)
    set_target_properties(terminal-ordered-bridge-header PROPERTIES LINKER_LANGUAGE CXX)
    target_link_libraries(terminal-ordered-bridge-header PRIVATE styx_terminal_bridge ${INFERNO_UI_HOST_LIBRARIES})
    add_test(NAME terminal-ordered-bridge-cxx98 COMMAND terminal-ordered-bridge-header)
endif()
