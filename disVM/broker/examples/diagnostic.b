# Run a typed diagnostic receive worker on Dis; a native producer supplies the BD1 file.
implement Diagnostic;
include "sys.m";
include "brokerdiag.m";


Diagnostic: module
{
    init: fn(); # Host entry; no arguments or return value.
};


# Decode on an ordinary Dis process and publish the owned record through a typed channel.
# d is a loaded pure module; input/output are local Dis channels, not native heap pointers.
worker(d: Brokerdiag, input: chan of array of byte, output: chan of ref Brokerdiag->Event)
{
    frame := <-input; # This diagnostic worker may block without stopping the broker/transport owner.
    (ok, event) := d->decode(frame);
    if(!ok){
        raise "fail: malformed broker diagnostic";
    }
    output <-= event; # Only this local worker waits for the receiving application process.
}


# Read a counted fixture generated by the real C broker, then exercise actual Dis channels.
# Runtime native file access is used only by this example; the codec module imports no Sys.
init()
{
    s := load Sys Sys->PATH;
    d := load Brokerdiag Brokerdiag->PATH;
    if(s == nil || d == nil){
        raise "fail: missing diagnostic modules";
    }
    fd := s->open("diagnostic.bd1", Sys->OREAD);
    if(fd == nil){
        raise "fail: missing diagnostic frame";
    }
    bytes := array[Brokerdiag->MaxFrame] of byte;
    count := s->read(fd, bytes, len bytes);
    if(count <= 0){
        raise "fail: diagnostic frame read";
    }
    input := chan of array of byte;
    output := chan of ref Brokerdiag->Event;
    spawn worker(d, input, output);
    input <-= bytes[0:count];
    event := <-output;
    # Hex ID/offset strings remain exact on classic int32 and the experimental native-cell target.
    s->print("DIAG %d %s %s %s %s %s %s\n", event.kind, event.requestId,
             event.origin.line, event.origin.column, event.origin.offset, event.origin.path, event.peer);
    # A short malformed record must produce no partial event.
    (ok, ignored) := d->decode(array of byte "BD1");
    if(ok || ignored != nil){
        raise "fail: partial diagnostic accepted";
    }
}
