# EN: Exceed the public export catalogue limit by one supported method.
# RU: Превысить предел каталога на один поддерживаемый метод.
implement Overflow;

Overflow: module {
    a: fn(value: int): int;
    b: fn(value: int): int;
    c: fn(value: int): int;
    d: fn(value: int): int;
    e: fn(value: int): int;
    f: fn(value: int): int;
    g: fn(value: int): int;
    h: fn(value: int): int;
    i: fn(value: int): int;
};


# EN: Keep a callable with the supported Int32 signature.
# RU: Сохранить a вызываемым с поддерживаемой сигнатурой Int32.
a(value: int): int
{
    return value;
}


