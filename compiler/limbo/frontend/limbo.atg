/*
 * Читаемая грамматика и C99-предикаты синтаксического фронтенда.
 * Правила ниже создают необязательное конкретное дерево, но не проверяют типы.
 * main.c проверяет кодировку UTF-8 до запуска байтового сканера.
 * Квадратные скобки — необязательная часть, фигурные — повторение.
 * IF(...) проверяет выбор без потребления входного токена.
 */

/* Limbo syntax frontend. C99 target; no Dis or SWF code generation. */
COMPILER Limbo
/* Recursive grammar boundaries call a C99 guard owned by this parser only.
 * The embedding wrapper turns limit exhaustion into a returned diagnostic. */
void limbo_syntax_enter(void);
void limbo_syntax_leave(void);
/* Optional owned concrete-tree recorder; offsets are UTF-8 byte positions.
 * Disabled during ordinary syntax checks. Empty rules anchor at lookahead. */
void limbo_tree_enter(const char *kind, long start);
void limbo_tree_leave(long end);

/* Scan ahead without changing Coco/R scanner state. Delimiters inside strings,
   comments or nested expressions do not terminate the current qualifier. */
static int AheadArrow(void)
{
    /* Begin at the lookahead token; never call the consuming S_Get here. */
    long pos = S_NextPos;
    int depth = 0;       /* Parenthesis/subscript nesting hides inner arrows. */
    int initializer = 0; /* Only an of-{...} brace may open at expression depth zero. */
    int quote = 0;       /* Zero outside a string, otherwise the opening quote. */
    int ch;
    while ((ch = S_CurrentCh(pos)) != 0)
    {
        int next = S_CurrentCh(pos + 1);
        if (quote)
        {
            /* Skip the escaped byte so an escaped quote cannot end the string. */
            if (ch == 92 && next)
                ++pos;
            else if (ch == quote)
                quote = 0;
        }
        else if (ch == 34 || ch == 39)
        {
            quote = ch;
        }
        else if (ch == '#')
        {
            /* A comment may contain an arrow that is not a grammar separator. */
            while (S_CurrentCh(pos) && S_CurrentCh(pos) != 10)
                ++pos;
            continue;
        }
        else if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_' ||
                 ch >= 128)
        {
            long start = pos;
            do
            {
                ch = S_CurrentCh(++pos);
            } while ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
                     (ch >= '0' && ch <= '9') || ch == '_' || ch >= 128);
            initializer = pos - start == 2 && S_CurrentCh(start) == 'o' &&
                          S_CurrentCh(start + 1) == 'f';
            continue;
        }
        else if (ch == '{')
        {
            if (!depth && !initializer)
                return 0;
            initializer = 0;
            ++depth;
        }
        else if (ch == '(' || ch == '[')
        {
            ++depth;
        }
        else if (ch == ')' || ch == ']' || ch == '}')
        {
            if (!depth)
                return 0;
            --depth;
        }
        else if (!depth)
        {
            /* Only an outer => starts a new case/alt/pick arm. */
            if (ch == '=' && next == '>')
                return 1;
            /* An ordinary statement ends or opens a block before any arm. */
            if (ch == ';' || ch == '{' || ch == '}')
                return 0;
        }
        if (ch != ' ' && ch != 9 && ch != 10 && ch != 13)
            initializer = 0;
        ++pos;
    }
    return 0;
}

/* Whitespace and # comments are transparent to contextual lookahead. */
static long Trivia(long pos)
{
    for (;;)
    {
        int ch = S_CurrentCh(pos);
        if (ch == ' ' || ch == 9 || ch == 10 || ch == 13)
            ++pos;
        else if (ch == '#')
            while (S_CurrentCh(pos) && S_CurrentCh(pos) != 10)
                ++pos;
        else
            return pos;
    }
}
/* A named conversion has a type-shaped prefix followed by a unary operand.
 * Calls and binary operators retain their existing precedence. Symbol resolution
 * later decides whether the qualified name actually denotes a type. */
static int NamedCastAhead(int is_ident)
{
    long pos = S_NextPos;
    int ch;
    if (!is_ident)
        return 0;
    for (;;)
    {
        ch = S_CurrentCh(pos);
        if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_' ||
              ch >= 128))
            return 0;
        do
        {
            ch = S_CurrentCh(++pos);
        } while ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
                 (ch >= '0' && ch <= '9') || ch == '_' || ch >= 128);
        pos = Trivia(pos);
        /* Instantiations can occur at every qualification level. This only
         * finds the matching bracket; NamedType validates its type contents. */
        if (S_CurrentCh(pos) == '[')
        {
            unsigned depth = 0;
            do
            {
                pos = Trivia(pos);
                ch = S_CurrentCh(pos++);
                if (!ch)
                    return 0;
                if (ch == '[')
                    ++depth;
                else if (ch == ']')
                    --depth;
            } while (depth);
            pos = Trivia(pos);
        }
        if (S_CurrentCh(pos) == '.')
            pos = Trivia(pos + 1);
        else if (S_CurrentCh(pos) == '-' && S_CurrentCh(pos + 1) == '>')
            pos = Trivia(pos + 2);
        else
            break;
    }
    ch = S_CurrentCh(pos);
    /* A contiguous != is comparison, not the start of a unary cast operand.
     * Keep !x and ~x valid after a named type; trivia cannot split an operator token. */
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
           (ch >= '0' && ch <= '9') || ch == '_' || ch >= 128 || ch == 34 || ch == 39 ||
           (ch == '!' && S_CurrentCh(pos + 1) != '=') || ch == '~';
}
/* Match a whole keyword after a candidate label without reading a token. */
static int WordAt(long pos, const char *word)
{
    int ch;
    while (*word)
        if (S_CurrentCh(pos++) != (unsigned char)*word++)
            return 0;
    ch = S_CurrentCh(pos);
    return !((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') ||
             (ch >= '0' && ch <= '9') || ch == '_' || ch >= 128);
}
/* A colon before a type is a declaration, not a control-statement label. */
static int LabelAhead(void)
{
    long pos = Trivia(S_NextPos + S_NextLen);
    if (S_CurrentCh(pos) != ':')
        return 0;
    pos = Trivia(pos + 1);
    return WordAt(pos, "while") || WordAt(pos, "do") || WordAt(pos, "for") ||
           WordAt(pos, "case") || WordAt(pos, "alt") || WordAt(pos, "pick");
}
/* Repetition resolver includes comma FIRST explicitly to guarantee progress. */
static int InitializerAfterComma(void)
{
    int ch = S_CurrentCh(Trivia(S_NextPos + S_NextLen));
    return ch && ch != '}';
}

/* Distinguish wildcard * from unary dereference by its following separator. */
static int WildcardAhead(void)
{
    long pos = Trivia(S_NextPos + S_NextLen);
    return (S_CurrentCh(pos) == '=' && S_CurrentCh(pos + 1) == '>') ||
           WordAt(pos, "or");
}

CHARACTERS
  /* Байты имён: ASCII и старшие байты UTF-8. Это не таблица категорий Unicode. */
  letter =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_" +
    CHR(128) .. CHR(255)
  .

  /* Продолжение последовательности UTF-8. */
  trail =
    CHR(128) .. CHR(191)
  .

  /* Начальный байт двухбайтового UTF-8. */
  lead2 =
    CHR(194) .. CHR(223)
  .

  /* Начальный байт трёхбайтового UTF-8. */
  lead3 =
    CHR(224) .. CHR(239)
  .

  /* Начальный байт четырёхбайтового UTF-8. */
  lead4 =
    CHR(240) .. CHR(244)
  .

  /* Один ASCII-символ для символьного литерала Limbo. */
  ascii =
    CHR(1) .. CHR(127) - "'" - "\\" - CHR(10) - CHR(13)
  .

  /* Шестнадцатеричные цифры. */
  hex =
    "0123456789abcdefABCDEF"
  .

  /* Десятичные цифры. */
  digit =
    "0123456789"
  .

  /* Латинские буквы для записи чисел с явным основанием. */
  alpha =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
  .

  /* Содержимое двойных кавычек без переводов строки и обратной косой черты. */
  dq =
    ANY - '"' - "\\" - CHR(10) - CHR(13) - CHR(0)
  .

  /* Содержимое одинарных кавычек без разделителей и переводов строки. */
  sq =
    ANY - "'" - "\\" - CHR(10) - CHR(13) - CHR(0)
  .

  /* Байты однострочного комментария; исключён EOF, поэтому допустим конец без LF. */
  linechar =
    ANY - CHR(10) - CHR(13) - CHR(0)
  .

  /* Байт после обратной косой черты; интерпретация escape — будущий проход. */
  escaped =
    ANY - CHR(0) - CHR(10) - CHR(13)
  .

TOKENS
  /* Идентификатор. Ключевые слова выделяются таблицей литералов Coco/R. */
  ident =
    letter
    {
        letter
        | digit
    }
  .

  /* Десятичное число с необязательной дробной частью и экспонентой. */
  number =
    digit
    {
        digit
    }
    [
        "."
        {
            digit
        }
    ]
    [
        (
            "e"
            | "E"
        )
        [
            "+"
            | "-"
        ]
        digit
        {
            digit
        }
    ]
  .

  /* Целое Limbo: основание r цифры; допустимость цифр проверяется семантически. */
  radix =
    digit
    {
        digit
    }
    (
        "r"
        | "R"
    )
    (
        digit
        | alpha
    )
    {
        digit
        | alpha
    }
  .

  /* Строковый литерал; кавычки и обратная косая черта не поглощаются как текст. */
  text =
    '"'
    {
        dq
        | "\\" escaped
    }
    '"'
  .

  /* Один символ Limbo: ASCII, UTF-8 либо поддерживаемая escape-последовательность. */
  character =
    "'"
    (
        ascii
        | lead2 trail
        | lead3 trail trail
        | lead4 trail trail trail
        | "\\"
        (
            "u" hex hex hex hex
            | "'"
            | '"'
            | "\\"
            | "n"
            | "r"
            | "t"
            | "a"
            | "b"
            | "v"
            | "0"
        )
    )
    "'"
  .

PRAGMAS
  /* Комментарий пропускается как pragma и не попадает в правила синтаксиса. */
  linecomment =
    "#"
    {
        linechar
    }
  .

IGNORE
  CHR(9) + CHR(10) + CHR(13)

PRODUCTIONS
  /* Единица Limbo: необязательный implement позволяет разбирать также интерфейсы .m. */
  Limbo =
                                                                        (. limbo_tree_enter("Limbo", 0); .)
    (
        [
            "implement" Names ";"
        ]
        {
            Top
        }
        EOF
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Верхний уровень Limbo: include, объявление/функция или распаковка кортежа. */
  Top =
                                                                        (. limbo_tree_enter("Top", S_NextPos); .)
    (
        "include" text ";"
        | ident NamedTop
        | "(" Names ")" ":=" Expression ";"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* После общего имени различаются определение функции и объявление данных. */
  NamedTop =
                                                                        (. limbo_tree_enter("NamedTop", S_NextPos); .)
    (
        PolyParameters
        {
            "." ident PolyParameters
        }
        FunctionTail
        |
        {
            "," ident
        }
        DeclarationTail
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Объявление с типом, выводом типа := либо инициализацией =. */
  DeclarationTail =
                                                                        (. limbo_tree_enter("DeclarationTail", S_NextPos); .)
    (
        ":" DeclType ";"
        |
        (
            ":="
            | "="
        )
        Expression ";"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Категории объявлений Limbo: константа, импорт, псевдоним, module, adt или тип. */
  DeclType =
                                                                        (. limbo_tree_enter("DeclType", S_NextPos); .)
    (
                                                                        (. limbo_syntax_enter(); .)
        (
            "con" Expression
            | "import" Expression
            | "type" Type
            | "module" "{"
            {
                Top
            }
            "}"
            | "exception"
            [
                "(" TypeList ")"
            ]
            | "adt" PolyParameters ForPoly "{"
            {
                AdtMember
            }
            "}" ForPoly
            |
            [
                "cyclic"
            ]
            Type
            [
                "=" Expression
            ]
        )
                                                                        (. limbo_syntax_leave(); .)
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Члены ADT, включая размеченные варианты pick.
  Предпросмотр => не позволяет принять имя следующего варианта за поле. */
  AdtMember =
                                                                        (. limbo_tree_enter("AdtMember", S_NextPos); .)
    (
        Names ":" DeclType ";"
        | "pick" "{"
        {
            Tags "=>"
            {
                IF(!AheadArrow() && Sym != RbraceSym && Sym != EOF_Sym )
                Names ":" DeclType ";"
            }
        }
        "}"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Группа имён, разделённых запятыми; используется в объявлениях и параметрах. */
  /* Метки вариантов ADT соединяются ключевым словом or. */
  Tags =
                                                                        (. limbo_tree_enter("Tags", S_NextPos); .)
    (
        ident
        {
            "or" ident
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  Names =
                                                                        (. limbo_tree_enter("Names", S_NextPos); .)
    (
        Name
        {
            "," Name
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Имя либо nil для безымянного параметра; проверка контекста — семантическая. */
  Name =
                                                                        (. limbo_tree_enter("Name", S_NextPos); .)
    (
        ident
        | "nil"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Базовые, составные и именованные типы Limbo. ref и контейнеры
  рекурсивно охватывают внутренний тип; fn содержит отдельную сигнатуру. */
  Type =
                                                                        (. limbo_tree_enter("Type", S_NextPos); .)
    (
                                                                        (. limbo_syntax_enter(); .)
        (
            "byte"
            | "int"
            | "big"
            | "real"
            | "string"
            | FixedType
            |
            (
                "array"
                | "table"
                | "list"
                | "chan"
            )
            "of" Type
            | "ref" Type
            | "fn" PolyParameters Parameters
            [
                IF(Sym == ColonSym) ":" Type
            ]
            ForPoly Raises
            | "(" TypeList ")"
            | NamedType
        )
                                                                        (. limbo_syntax_leave(); .)
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Скобки вокруг необязательного списка формальных параметров Limbo. */
  Parameters =
                                                                        (. limbo_tree_enter("Parameters", S_NextPos); .)
    (
                                                                        (. int variadic = 0; .)
        "("
        [
                                                                        (. variadic = Sym == StarSym; .)
            Formal
            {
                ","                                                     (.
                                                                            if (variadic)
                                                                                SemError(1302);
                                                                            variadic = Sym == StarSym;
                                                                        .)
                Formal
            }
        ]
        ")"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Формальный параметр: группа имён и тип, self-параметр либо вариативная звёздочка. */
  Formal =
                                                                        (. limbo_tree_enter("Formal", S_NextPos); .)
    (
        "*"
        | Names ":"
        (
            "self"
            [
                "ref"
            ]
            NamedType
            | Type
        )
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Сигнатура определения Limbo и тело: возвращаемый тип необязателен. */
  FunctionTail =
                                                                        (. limbo_tree_enter("FunctionTail", S_NextPos); .)
    (
        Parameters
        [
            IF(Sym == ColonSym) ":" Type
        ]
        ForPoly Raises Block
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Блок ограничивает последовательность элементов фигурными скобками. */
  Block =
                                                                        (. limbo_tree_enter("Block", S_NextPos); .)
    (
        "{"
        {
            Statement
        }
        "}"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Инструкции Limbo. Декларация локальной переменной использует общий
  префикс выражения; после двоеточия разбирается DeclType.
  Ветвления каналов/вариантов вынесены в отдельные правила ниже. */
  Statement =
                                                                        (. limbo_tree_enter("Statement", S_NextPos); .)
    (
                                                                        (. limbo_syntax_enter(); .)
        (
            IF(Sym==identSym && LabelAhead()) ident ":"
            LabeledStatement
            | Block
            [
                IF(Sym == exceptionSym) "exception"
                [
                    ident
                ]
                "{"
                {
                    CaseArm
                }
                "}"
            ]
            | ";"
            | "include" text ";"
            | IfStatement
            | LabeledStatement
            | "return"
            [
                Expression
            ]
            ";"
            |
            (
                "break"
                | "continue"
            )
            [
                ident
            ]
            ";"
            | "raise"
            [
                Expression
            ]
            ";"
            | "exit" ";"
            | "spawn" Expression ";"
            | Expression
            [
                ":" DeclType
            ]
            ";"
        )
                                                                        (. limbo_syntax_leave(); .)
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Only the six labelable control statements admit a leading label. */
  LabeledStatement =
                                                                        (. limbo_tree_enter("LabeledStatement", S_NextPos); .)
    (
        WhileStatement
        | ForStatement
        | CaseStatement
        | AltStatement
        | PickStatement
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Ближайший незавершённый if получает else; вход проверяется без Get(). */
  IfStatement =
                                                                        (. limbo_tree_enter("IfStatement", S_NextPos); .)
    (
        "if" "(" Expression ")" Statement
        [
            IF(Sym == elseSym) "else" Statement
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* В Limbo условие while может отсутствовать: такой цикл бесконечен. */
  WhileStatement =
                                                                        (. limbo_tree_enter("WhileStatement", S_NextPos); .)
    (
        "while" "("
        [
            Expression
        ]
        ")" Statement
        | "do" Statement "while" "("
        [
            Expression
        ]
        ")" ";"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Три части for разделены точками с запятой; каждая может отсутствовать. */
  ForStatement =
                                                                        (. limbo_tree_enter("ForStatement", S_NextPos); .)
    (
        "for" "("
        [
            Expression
        ]
        ";"
        [
            Expression
        ]
        ";"
        [
            Expression
        ]
        ")" Statement
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* case сравнивает выражение с условиями; alt выбирает доступную операцию
  канала. Синтаксис ветвей общий, семантика будет проверяться отдельно. */
  CaseStatement =
                                                                        (. limbo_tree_enter("CaseStatement", S_NextPos); .)
    (
        "case" Expression "{" CaseArm
        {
            CaseArm
        }
        "}"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Выбор готовой операции канала; выражение после alt не требуется. */
  AltStatement =
                                                                        (. limbo_tree_enter("AltStatement", S_NextPos); .)
    (
        "alt" "{" CaseArm
        {
            CaseArm
        }
        "}"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Тело ветви может быть пустым. Предикат отличает следующую метку =>
  от начала инструкции; закрывающая скобка и EOF явно исключены. */
  CaseArm =
                                                                        (. limbo_tree_enter("CaseArm", S_NextPos); .)
    (
        Qualifiers "=>"
        [
            IF(!AheadArrow() && Sym != RbraceSym && Sym != EOF_Sym)
            ArmBody
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* pick связывает имя с выбранным вариантом ADT; типовая корректность
  значения и существование перечисленных тегов здесь не проверяются. */
  PickStatement =
                                                                        (. limbo_tree_enter("PickStatement", S_NextPos); .)
    (
        "pick" ident ":=" Expression "{" PickArm
        {
            PickArm
        }
        "}"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Теги варианта соединяются or; звёздочка задаёт запасной вариант. */
  PickArm =
                                                                        (. limbo_tree_enter("PickArm", S_NextPos); .)
    (
        (
            Tags
            | "*"
        )
        "=>"
        [
            IF(!AheadArrow() && Sym != RbraceSym && Sym != EOF_Sym)
            ArmBody
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Первая инструкция обязательна: пустота разрешена в вызывающем правиле.
  Продолжение не поглощает следующую метку или конец блока. */
  ArmBody =
                                                                        (. limbo_tree_enter("ArmBody", S_NextPos); .)
    (
        Statement
        {
            IF(!AheadArrow() && Sym != RbraceSym && Sym != EOF_Sym)
            Statement
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Условия case/alt: выражение, диапазон to, объединение or либо звёздочка. */
  Qualifiers =
                                                                        (. limbo_tree_enter("Qualifiers", S_NextPos); .)
    (
        Qualifier
        {
            "or" Qualifier
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Wildcards end at or/=>; *p is instead an ordinary dereference expression. */
  Qualifier =
                                                                        (. limbo_tree_enter("Qualifier", S_NextPos); .)
    (
        IF(Sym==StarSym && WildcardAhead()) "*"
        | Expression
        [
            "to" Expression
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Самый низкий приоритет: последовательность выражений через запятую. */
  Expression =
                                                                        (. limbo_tree_enter("Expression", S_NextPos); .)
    (
        Assignment
        {
            "," Assignment
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Присваивание разбирается рекурсией справа: a = b = c.
  Проверка допустимости левой части относится к будущему семантическому проходу. */
  Assignment =
                                                                        (. limbo_tree_enter("Assignment", S_NextPos); .)
    (
                                                                        (. limbo_syntax_enter(); .)
        (
            LoadExpression
            [
                (
                    "="
                    | ":="
                    | "+="
                    | "-="
                    | "*="
                    | "/="
                    | "%="
                    | "**="
                    | "&="
                    | "|="
                    | "^="
                    | "<<="
                    | ">>="
                    | "<-"
                    [
                        "="
                    ]
                    | "<-="
                )
                Assignment
            ]
        )
                                                                        (. limbo_syntax_leave(); .)
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Конструирование списка :: рекурсивно справа и связывается слабее логических операций. */
  Cons =
                                                                        (. limbo_tree_enter("Cons", S_NextPos); .)
    (
                                                                        (. limbo_syntax_enter(); .)
        BitOr
        [
            "::" Cons
        ]
                                                                        (. limbo_syntax_leave(); .)
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Логическое ИЛИ; более сильные операторы разбираются внутри LogicalAnd. */
  LogicalOr =
                                                                        (. limbo_tree_enter("LogicalOr", S_NextPos); .)
    (
        LogicalAnd
        {
            "||" LogicalAnd
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Логическое И; следующий уровень — побитовое ИЛИ. */
  LogicalAnd =
                                                                        (. limbo_tree_enter("LogicalAnd", S_NextPos); .)
    (
        Cons
        {
            "&&" Cons
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Побитовое ИЛИ. Повторение задаёт левую ассоциативность этого уровня. */
  BitOr =
                                                                        (. limbo_tree_enter("BitOr", S_NextPos); .)
    (
        BitXor
        {
            "|" BitXor
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Побитовое исключающее ИЛИ; операнды имеют более высокий приоритет. */
  BitXor =
                                                                        (. limbo_tree_enter("BitXor", S_NextPos); .)
    (
        BitAnd
        {
            "^" BitAnd
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Побитовое И; сравнения равенства связываются сильнее. */
  BitAnd =
                                                                        (. limbo_tree_enter("BitAnd", S_NextPos); .)
    (
        Equality
        {
            "&" Equality
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Сравнения равенства; каждый операнд сначала проходит относительные сравнения. */
  Equality =
                                                                        (. limbo_tree_enter("Equality", S_NextPos); .)
    (
        Relational
        {
            (
                "=="
                | "!="
            )
            Relational
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Относительные сравнения; операции сдвига имеют более высокий приоритет. */
  Relational =
                                                                        (. limbo_tree_enter("Relational", S_NextPos); .)
    (
        Shift
        {
            (
                "<"
                | ">"
                | "<="
                | ">="
            )
            Shift
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Сдвиги; сложение и вычитание разбираются до выполнения сдвига. */
  Shift =
                                                                        (. limbo_tree_enter("Shift", S_NextPos); .)
    (
        Additive
        {
            (
                "<<"
                | ">>"
            )
            Additive
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Сложение/вычитание: повторение — левая ассоциативность, Product — сильнее. */
  Additive =
                                                                        (. limbo_tree_enter("Additive", S_NextPos); .)
    (
        Product
        {
            (
                "+"
                | "-"
            )
            Product
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Умножение, деление и остаток: операнды разбираются как унарные выражения. */
  Product =
                                                                        (. limbo_tree_enter("Product", S_NextPos); .)
    (
        Unary
        {
            (
                "*"
                | "/"
                | "%"
            )
            Unary
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Префиксные операции рекурсивны; Postfix отвечает за вызовы и обращения. */
  /* chan/array создают составные значения; ref, <- и преобразования типов
  являются префиксами. load содержит имя типа загружаемого модуля. */
  Unary =
                                                                        (. limbo_tree_enter("Unary", S_NextPos); .)
    (
                                                                        (. limbo_syntax_enter(); .)
        (
            IF(NamedCastAhead(Sym == identSym)) NamedType Unary
            |
            (
                "!"
                | "~"
                | "+"
                | "-"
                | "++"
                | "--"
                | "<-"
                | "hd"
                | "tl"
                | "len"
                | "keysof"
                | "tagof"
                | "ref"
                | "byte"
                | "int"
                | "big"
                | "real"
                | "string"
                | "*"
            )
            Unary
            | FixedType Unary
            | "chan"
            [
                "[" Expression "]"
            ]
            "of" Type
            | ArrayCreation
            | "table" "of" Type
            | "list" "of" "{" ListElements "}"
            | Power
        )
                                                                        (. limbo_syntax_leave(); .)
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* An omitted size is legal only when initializer values determine it. */
  ArrayCreation =
                                                                        (. limbo_tree_enter("ArrayCreation", S_NextPos); .)
    (
                                                                        (. int sized = 0; .)
        "array"
        (
            "["
            [
                Expression                                              (. sized = 1; .)
            ]
            "]" "of"
            (
                Type                                                    (.
                                                                            if (!sized)
                                                                                SemError(1301);
                                                                        .)
                | "{" InitializerList "}"
            )
            | "of"
            (
                "byte"
                | "int"
                | "big"
                | "real"
                | "string"
            )
            Unary
        )
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* A single trailing comma is allowed; an empty initializer list is not. */
  InitializerList =
                                                                        (. limbo_tree_enter("InitializerList", S_NextPos); .)
    (
        Initializer
        {
            IF(Sym==CommaSym && InitializerAfterComma()) ","
            Initializer
        }
        [
            ","
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Элемент array initializer либо индекс => значение, включая * => значение. */
  Initializer =
                                                                        (. limbo_tree_enter("Initializer", S_NextPos); .)
    (
        IF(Sym==StarSym && WildcardAhead()) "*" "=>" Assignment
        | Assignment
        [
            "=>" Assignment
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Цепочка обращений к полям, индексирования и вызовов; затем ++ или --. */
  Postfix =
                                                                        (. limbo_tree_enter("Postfix", S_NextPos); .)
    (
        Primary
        {
            "." ident
            | "->" ident
            | Subscript
            | "("
            [
                Expression
            ]
            ")"
        }
        [
            "++"
            | "--"
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Index or slice: either bound may be omitted, but an empty index is illegal. */
  Subscript =
                                                                        (. limbo_tree_enter("Subscript", S_NextPos); .)
    (
        "["
        (
            ":"
            [
                Expression
            ]
            | Export
            (
                ":"
                [
                    Expression
                ]
                |
                {
                    "," Export
                }
            )
        )
        "]"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Атомы выражений: литералы, имена, группировка и составные литералы. */
  Primary =
                                                                        (. limbo_tree_enter("Primary", S_NextPos); .)
    (
                                                                        (. limbo_syntax_enter(); .)
        (
            ident
            | number
            | radix
            | text
            | character
            | "nil"
            | "(" Expression ")"
        )
                                                                        (. limbo_syntax_leave(); .)
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Polymorphic declaration variables, not instantiation types. */
  PolyParameters =
                                                                        (. limbo_tree_enter("PolyParameters", S_NextPos); .)
    (
        [
            "[" Names "]"
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Named types can be instantiated at each module/ADT qualification level. */
  NamedType =
                                                                        (. limbo_tree_enter("NamedType", S_NextPos); .)
    (
        ident TypeArguments
        {
            (
                "->"
                | "."
            )
            ident TypeArguments
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Concrete type arguments; empty instantiations are not legal. */
  TypeArguments =
                                                                        (. limbo_tree_enter("TypeArguments", S_NextPos); .)
    (
        [
            "[" TypeList "]"
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Tuple/instantiation types retain optional cyclic qualifiers per element. */
  TypeList =
                                                                        (. limbo_tree_enter("TypeList", S_NextPos); .)
    (
        [
            "cyclic"
        ]
        Type
        {
            ","
            [
                "cyclic"
            ]
            Type
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Constraint groups name one or more polymorphic variables, followed by their required fields. */
  ForPoly =
                                                                        (. limbo_tree_enter("ForPoly", S_NextPos); .)
    (
        [
            IF(Sym == forSym) "for" "{" ConstraintGroup
            {
                ConstraintGroup
            }
            "}"
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* A constraint group can have zero fields, but for {} cannot omit all variable groups. */
  ConstraintGroup =
                                                                        (. limbo_tree_enter("ConstraintGroup", S_NextPos); .)
    (
        Names "=>"
        {
            IF(!AheadArrow() && Sym != RbraceSym && Sym != EOF_Sym)
            Names ":"
            [
                "cyclic"
            ]
            Type ";"
        }
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Declared exception names are identifiers or identifier tuples, never arbitrary expressions. */
  Raises =
                                                                        (. limbo_tree_enter("Raises", S_NextPos); .)
    (
        [
            IF(Sym == raisesSym) "raises"
            (
                "(" ExceptionNames ")"
                | ident
            )
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Nested exception-name tuples use the same source spelling as the reference grammar. */
  ExceptionNames =
                                                                        (. limbo_tree_enter("ExceptionNames", S_NextPos); .)
    (
                                                                        (. limbo_syntax_enter(); .)
        (
            ident
            | "nil"
            | "(" ExceptionNames ")"
        )
        {
            ","
            (
                ident
                | "nil"
                | "(" ExceptionNames ")"
            )
        }
                                                                        (. limbo_syntax_leave(); .)
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Fixed-point type/conversion has one or two scale expressions. */
  FixedType =
                                                                        (. limbo_tree_enter("FixedType", S_NextPos); .)
    (
        "fixed" "(" Assignment
        [
            "," Assignment
        ]
        ")"
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Load binds less strongly than logical operators and more strongly than assignment. */
  LoadExpression =
                                                                        (. limbo_tree_enter("LoadExpression", S_NextPos); .)
    (
                                                                        (. limbo_syntax_enter(); .)
        (
            "load" ident LoadExpression
            | LogicalOr
        )
                                                                        (. limbo_syntax_leave(); .)
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Exponentiation associates right; postfix operations bind before it. */
  Power =
                                                                        (. limbo_tree_enter("Power", S_NextPos); .)
    (
        Postfix
        [
            "**" Unary
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* A single trailing comma is permitted in nonempty list literals. */
  ListElements =
                                                                        (. limbo_tree_enter("ListElements", S_NextPos); .)
    (
        Assignment
        {
            IF(Sym == CommaSym && InitializerAfterComma()) ","
            Assignment
        }
        [
            ","
        ]
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

  /* Export brackets accept either types or expressions. A builtin/composite type
  may also prefix a conversion expression; list-of-{...} stays a value literal.
  Type-name binding and instantiation arity are checked by a later semantic pass. */
  Export =
                                                                        (. limbo_tree_enter("Export", S_NextPos); .)
    (
        IF(Sym == byteSym || Sym == intSym || Sym == bigSym || Sym == realSym ||
       Sym == stringSym || Sym == cyclicSym ||
       (Sym == listSym && S_CurrentCh(Trivia(Trivia(S_NextPos + S_NextLen) + 2)) != '{') ||
       (Sym == arraySym && S_CurrentCh(Trivia(S_NextPos + S_NextLen)) != '['))
        [
            "cyclic"
        ]
        Type
        [
            IF(Sym != RbrackSym && Sym != CommaSym && Sym != ColonSym && Sym != EOF_Sym)
            Assignment
        ]
        | Assignment
    )
                                                                        (. limbo_tree_leave(S_Pos + S_Len); .)
  .

END
  Limbo
  .

