/*
 * Читаемая грамматика и C99-предикаты синтаксического фронтенда.
 * Правила ниже не создают AST и не выполняют проверку типов.
 * main.c проверяет кодировку UTF-8 до запуска байтового сканера.
 * Квадратные скобки — необязательная часть, фигурные — повторение.
 * IF(...) проверяет выбор без потребления входного токена.
 */
/* AS3 syntax with E4X, vectors, metadata and parser-selected lexical goals; no ABC emission. */
COMPILER As3
#include <string.h>

/* Unicode categories are pinned and shared as data, never taken from locale. */
#include "unicode_ident.inc"

/* Binary search sorted inclusive category ranges in logarithmic time. */
static int IdentifierIn(unsigned long value, const IdentifierRange *ranges,
                        unsigned count)
{
    unsigned low = 0;
    while (low < count)
    {
        unsigned middle = low + (count - low) / 2;
        if (value < ranges[middle].first)
            count = middle;
        else if (value > ranges[middle].last)
            low = middle + 1;
        else
            return 1;
    }
    return 0;
}
/* Decode one validated UTF-8 scalar or one exact four-hex-digit identifier escape. */
static int IdentifierUnit(long *pos, long end, unsigned long *value)
{
    int ch, remaining = 0;
    unsigned long code;
    if (*pos >= end)
        return 0;
    ch = S_CurrentCh((*pos)++);
    if (ch == 92)
    {
        int i;
        if (*pos + 5 > end || S_CurrentCh((*pos)++) != 'u')
            return 0;
        code = 0;
        for (i = 0; i < 4; ++i)
        {
            int digit;
            ch = S_CurrentCh((*pos)++);
            digit = ch >= '0' && ch <= '9'   ? ch - '0'
                    : ch >= 'A' && ch <= 'F' ? ch - 'A' + 10
                    : ch >= 'a' && ch <= 'f' ? ch - 'a' + 10
                                             : -1;
            if (digit < 0)
                return 0;
            code = code * 16 + digit;
        }
    }
    else
    {
        code = (unsigned char)ch;
        if (code >= 240)
        {
            code &= 7;
            remaining = 3;
        }
        else if (code >= 224)
        {
            code &= 15;
            remaining = 2;
        }
        else if (code >= 192)
        {
            code &= 31;
            remaining = 1;
        }
        if (*pos + remaining > end)
            return 0;
        while (remaining--)
            code = code * 64 + (S_CurrentCh((*pos)++) & 63);
    }
    *value = code;
    return code < 0xd800 || (code > 0xdfff && code <= 0x10ffff);
}
/* Validate start/part categories after Coco/R has recognized the byte spelling. */
int as3_identifier_valid(long pos, int length)
{
    long end = pos + length;
    int first = 1;
    while (pos < end)
    {
        unsigned long code;
        int start;
        if (!IdentifierUnit(&pos, end, &code))
            return 0;
        start = code == '$' || code == '_' ||
                IdentifierIn(code, identifier_start_ranges,
                             sizeof(identifier_start_ranges) /
                                 sizeof(identifier_start_ranges[0]));
        if (!start && (first || !(code == 0x200c || code == 0x200d ||
                                  IdentifierIn(code, identifier_part_ranges,
                                               sizeof(identifier_part_ranges) /
                                                   sizeof(identifier_part_ranges[0])))))
            return 0;
        first = 0;
    }
    return !first;
}
/* Return raw UTF-8 whitespace width; escape spellings never become whitespace. */
int as3_identifier_space(long pos, int *line)
{
    long next = pos;
    unsigned long code;
    *line = 0;
    if ((S_CurrentCh(pos) >= 128 && S_CurrentCh(pos) < 194) || S_CurrentCh(pos) == 92 ||
        !IdentifierUnit(&next, pos + 4, &code))
        return 0;
    if (code == 0x2028 || code == 0x2029)
    {
        *line = 1;
        return (int)(next - pos);
    }
    return code == 11 || code == 12 || code == 0xa0 || code == 0x1680 ||
                   (code >= 0x2000 && code <= 0x200a) || code == 0x202f ||
                   code == 0x205f || code == 0x3000 || code == 0xfeff
               ? (int)(next - pos)
               : 0;
}
/* Compare contextual names by decoded spelling, without changing source bytes. */
static int IdentifierEqual(long pos, int length, const char *word)
{
    long end = pos + length;
    while (pos < end)
    {
        unsigned long code;
        if (!*word || !IdentifierUnit(&pos, end, &code) ||
            code != (unsigned char)*word++)
            return 0;
    }
    return !*word;
}
/* Escapes may spell names, but may not smuggle a reserved word into a binding.
 * PropertyName keeps its separate IdentifierName behavior in AS3. */
static int IdentifierReserved(long pos, int length)
{
    long end = pos + length;
    char word[32];
    unsigned used = 0, i;
    static const char *const reserved[] = {
        "as",       "break",      "case",      "catch",   "class",      "const",
        "continue", "default",    "delete",    "do",      "dynamic",    "else",
        "extends",  "false",      "final",     "finally", "for",        "function",
        "if",       "implements", "import",    "in",      "instanceof", "interface",
        "internal", "is",         "namespace", "new",     "null",       "override",
        "package",  "private",    "protected", "public",  "return",     "static",
        "super",    "switch",     "this",      "throw",   "true",       "try",
        "typeof",   "undefined",  "use",       "var",     "void",       "while",
        "with"};
    while (pos < end)
    {
        unsigned long code;
        if (!IdentifierUnit(&pos, end, &code) || code > 127 || used + 1 >= sizeof(word))
            return 0;
        word[used++] = (char)code;
    }
    word[used] = 0;
    for (i = 0; i < sizeof(reserved) / sizeof(reserved[0]); ++i)
        if (!strcmp(word, reserved[i]))
            return 1;
    return 0;
}

/* Strings keep UTF-16 escape values, including surrogate code units. Validate
 * spelling here; identifier category rules must not be applied to string data. */
int as3_string_valid(long pos, int length)
{
    long end = pos + length - 1;
    ++pos;
    while (pos < end)
    {
        int ch = S_CurrentCh(pos++);
        if (ch == 92)
        {
            int count = 0, i;
            if (pos >= end)
                return 0;
            ch = S_CurrentCh(pos++);
            if (ch == 'u')
                count = 4;
            else if (ch == 'x')
                count = 2;
            for (i = 0; i < count; ++i)
            {
                int digit = S_CurrentCh(pos++);
                if (pos > end ||
                    !((digit >= '0' && digit <= '9') ||
                      (digit >= 'a' && digit <= 'f') || (digit >= 'A' && digit <= 'F')))
                    return 0;
            }
            if (ch == 13 && S_CurrentCh(pos) == 10)
                ++pos;
            if (ch == 226 && S_CurrentCh(pos) == 128 &&
                (S_CurrentCh(pos + 1) == 168 || S_CurrentCh(pos + 1) == 169))
                pos += 2;
        }
        else if (ch == 10 || ch == 13 ||
                 (ch == 226 && S_CurrentCh(pos) == 128 &&
                  (S_CurrentCh(pos + 1) == 168 || S_CurrentCh(pos + 1) == 169)))
            return 0;
    }
    return pos == end;
}

/* All four source line terminators also end a single-line comment. */
static int IdentifierLine(long pos)
{
    int ch = S_CurrentCh(pos);
    return ch == 10 || ch == 13 ||
           (ch == 226 && S_CurrentCh(pos + 1) == 128 &&
            (S_CurrentCh(pos + 2) == 168 || S_CurrentCh(pos + 2) == 169));
}
/* LabelAhead: inspect the bytes after an identifier without consuming a token.
 * Whitespace and both comment forms may separate the name from its colon.
 * Returning zero leaves the identifier available to the expression production. */
static int LabelAhead(void)
{
    /* S_NextLen counts bytes, including every UTF-8 byte in the identifier. */
    long pos = S_NextPos + S_NextLen;
    int ch; /* Current source byte; zero is the scanner's EOF sentinel. */

    for (;;)
    {
        int line, width = as3_identifier_space(pos, &line);
        ch = S_CurrentCh(pos);
        if (width)
            pos += width;
        else if (ch == ' ' || ch == 9 || ch == 10 || ch == 13)
        {
            ++pos; /* Skip whitespace without altering source positions. */
        }
        else if (ch == '/' && S_CurrentCh(pos + 1) == '*')
        {
            pos += 2; /* Pass the block-comment opening delimiter. */
            while (S_CurrentCh(pos) &&
                   !(S_CurrentCh(pos) == '*' && S_CurrentCh(pos + 1) == '/'))
            {
                ++pos; /* Ignore colons inside the comment. */
            }
            if (!S_CurrentCh(pos))
                return 0; /* Unterminated comment is not a label. */
            pos += 2;     /* Pass the closing delimiter before checking again. */
        }
        else if (ch == '/' && S_CurrentCh(pos + 1) == '/')
        {
            while (S_CurrentCh(pos) && !IdentifierLine(pos))
            {
                ++pos; /* Skip the line comment, including any apparent colon. */
            }
        }
        else
        {
            return ch == ':' && S_CurrentCh(pos + 1) !=
                                    ':'; /* Only the next non-comment byte decides. */
        }
    }
}

/* NoIn applies only to an unparenthesized for initializer. Parentheses and
 * nested function bodies restore ordinary expression grammar locally. */
static int allow_in = 1;
/* A Coco/R repetition resolver replaces FIRST, so include the complete
 * operator set to guarantee progress on delimiters and invalid input. */
static int RelationalAhead(int token)
{
    return token == LessSym || token == GreaterSym || token == LessEqualSym ||
           token == GreaterEqualSym || token == instanceofSym || token == isSym ||
           token == asSym || (token == inSym && allow_in);
}

/* Skip whitespace/comments without consuming a scanner token. */
static long Trivia(long pos)
{
    for (;;)
    {
        int ch = S_CurrentCh(pos), next = S_CurrentCh(pos + 1);
        int line, width = as3_identifier_space(pos, &line);
        if (width)
            pos += width;
        else if (ch == ' ' || ch == 9 || ch == 10 || ch == 13)
            ++pos;
        else if (ch == '/' && next == '/')
        {
            while (S_CurrentCh(pos) && !IdentifierLine(pos))
                ++pos;
        }
        else if (ch == '/' && next == '*')
        {
            pos += 2;
            while (S_CurrentCh(pos) &&
                   !(S_CurrentCh(pos) == '*' && S_CurrentCh(pos + 1) == '/'))
                ++pos;
            if (!S_CurrentCh(pos))
                return pos;
            pos += 2;
        }
        else
            return pos;
    }
}
/* Whole ASCII contextual keyword; Unicode continuation is never a boundary. */
static int WordAt(long pos, const char *word)
{
    int ch;
    while (*word)
        if (S_CurrentCh(pos++) != (unsigned char)*word++)
            return 0;
    {
        int line;
        if (as3_identifier_space(pos, &line))
            return 1;
    }
    ch = S_CurrentCh(pos);
    return !((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') ||
             (ch >= '0' && ch <= '9') || ch == '_' || ch == '$' || ch >= 128);
}
/* A custom namespace attribute precedes a member keyword; ordinary expressions
 * beginning with an identifier remain available to Statement. */
static int CustomModifierAhead(void)
{
    long pos = Trivia(S_NextPos + S_NextLen);
    return WordAt(pos, "function") || WordAt(pos, "var") || WordAt(pos, "const");
}
/* A compile-time namespace guard is distinguishable from a qualified call by
 * its following brace. The syntax API recognizes both branches, without values. */
static int ConfigBlockAhead(void)
{
    long pos = Trivia(S_NextPos + S_NextLen), start;
    int ch;
    if (S_CurrentCh(pos) != ':' || S_CurrentCh(pos + 1) != ':')
        return 0;
    pos = start = Trivia(pos + 2);
    while ((ch = S_CurrentCh(pos)) != 0)
    {
        if (ch == 92 && S_CurrentCh(pos + 1) == 'u')
            pos += 6;
        else if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
                 (ch >= '0' && ch <= '9') || ch == '_' || ch == '$' || ch >= 128)
            ++pos;
        else
            break;
    }
    return pos != start && S_CurrentCh(Trivia(pos)) == '{';
}
/* Complete repetition FIRST set, including contextual namespace attributes. */
static int ModifierAhead(int token)
{
    return token == publicSym || token == privateSym || token == protectedSym ||
           token == internalSym || token == staticSym || token == dynamicSym ||
           token == overrideSym || token == finalSym ||
           (token == identSym && CustomModifierAhead());
}
static int MemberAhead(int token)
{
    return ModifierAhead(token) || token == functionSym || token == varSym ||
           token == constSym || token == namespaceSym || token == useSym ||
           token == SemicolonSym || token == LbrackSym ||
           (token == identSym && ConfigBlockAhead());
}
/* Explicit declaration resolver factors common modifier prefixes from items. */
static int DeclarationAhead(int token)
{
    return token == classSym || token == interfaceSym || token == functionSym ||
           token == varSym || token == constSym || token == namespaceSym ||
           token == publicSym || token == privateSym || token == protectedSym ||
           token == internalSym || token == staticSym || token == dynamicSym ||
           token == overrideSym || token == finalSym ||
           (token == identSym && CustomModifierAhead());
}
/* get/set are contextual names, not globally reserved scanner keywords. */
static int AccessorName(void)
{
    return IdentifierEqual(S_Pos, S_Len, "get") || IdentifierEqual(S_Pos, S_Len, "set");
}

/* Restricted productions inspect original trivia, including line breaks inside
 * comments. Do not use token line numbers: a skipped pragma must not hide its newline.
 */
static int LineBreak(void)
{
    long pos;
    for (pos = S_Pos + S_Len; pos < S_NextPos; ++pos)
    {
        int ch = S_CurrentCh(pos);
        if (ch == 10 || ch == 13 ||
            (ch == 226 && S_CurrentCh(pos + 1) == 128 &&
             (S_CurrentCh(pos + 2) == 168 || S_CurrentCh(pos + 2) == 169)))
            return 1;
    }
    return 0;
}

/* A generic suffix is distinguished from a dotted qualified identifier by raw trivia.
 */
static int TypeArgumentsAhead(void)
{
    return S_CurrentCh(Trivia(S_NextPos + S_NextLen)) == '<';
}
/* Metadata is declaration-only: a bracket expression followed by ordinary code stays an
 * array. Balance brackets/quotes and comments without consuming scanner state. */
static int MetadataAhead(void)
{
    long pos = S_NextPos;
    int depth = 0, quote = 0;
    for (;; ++pos)
    {
        int ch = S_CurrentCh(pos);
        if (!ch)
            return 0;
        if (quote)
        {
            if (ch == 92 && S_CurrentCh(pos + 1))
                ++pos;
            else if (ch == quote)
                quote = 0;
        }
        else if (ch == 34 || ch == 39)
            quote = ch;
        else if (ch == '/' &&
                 (S_CurrentCh(pos + 1) == '/' || S_CurrentCh(pos + 1) == '*'))
            pos = Trivia(pos) - 1;
        else if (ch == '[')
            ++depth;
        else if (ch == ']' && !--depth)
        {
            pos = Trivia(pos + 1);
            return S_CurrentCh(pos) == '[' || WordAt(pos, "class") ||
                   WordAt(pos, "interface") || WordAt(pos, "function") ||
                   WordAt(pos, "var") || WordAt(pos, "const") ||
                   WordAt(pos, "public") || WordAt(pos, "private") ||
                   WordAt(pos, "protected") || WordAt(pos, "internal") ||
                   WordAt(pos, "static") || WordAt(pos, "final") ||
                   WordAt(pos, "override") || WordAt(pos, "dynamic");
        }
    }
}
/* Scanner extensions stay in this language's generated-scanner translation unit. */
int as3_scan_regexp(long *pattern_end, unsigned *flags);
void as3_split_greater(void);

/* xml remains a normal identifier except after the contextual default prefix. */
static int DefaultXmlAhead(void)
{
    return WordAt(Trivia(S_NextPos + S_NextLen), "xml");
}

/* Recursive grammar boundaries call a C99 guard owned by this parser only.
 * The embedding wrapper turns limit exhaustion into a returned diagnostic. */
void as3_syntax_enter(void);
void as3_syntax_leave(void);

/* Byte-preserving UTF-8 lexer; semantic Unicode validation is a later pass. */

static int Sym;
void as3_syntax_enter(void);
void as3_syntax_leave(void);

/* XML is a parser-selected lexical goal. Interpolations re-enter the ordinary
 * Coco/R expression grammar; XML text never passes through the AS token DFA. */
static void Get(void);
static void Expression(void);
void as3_seek_source(long position);

/* Raw XML whitespace is not an ActionScript token boundary. */
static long XmlSpace(long pos)
{
    while (S_CurrentCh(pos) == ' ' || S_CurrentCh(pos) == 9 || S_CurrentCh(pos) == 10 ||
           S_CurrentCh(pos) == 13)
        ++pos;
    return pos;
}
/* Match a fixed delimiter without advancing or allocating source storage. */
static int XmlAt(long pos, const char *text)
{
    while (*text)
        if (S_CurrentCh(pos++) != (unsigned char)*text++)
            return 0;
    return 1;
}
/* Decode validated UTF-8 without locale dependence. The public API validates bytes. */
static unsigned long XmlCode(long *pos)
{
    unsigned long value = (unsigned char)S_CurrentCh((*pos)++);
    int count = 0;
    if (value >= 240)
    {
        value &= 7;
        count = 3;
    }
    else if (value >= 224)
    {
        value &= 15;
        count = 2;
    }
    else if (value >= 192)
    {
        value &= 31;
        count = 1;
    }
    while (count--)
        value = value * 64 + ((unsigned char)S_CurrentCh((*pos)++) & 63);
    return value;
}
/* XML 1.0 fifth-edition NameStartChar; independent of the host's wchar_t. */
static int XmlStart(unsigned long c)
{
    return c == ':' || c == '_' || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
           (c >= 0xc0 && c <= 0xd6) || (c >= 0xd8 && c <= 0xf6) ||
           (c >= 0xf8 && c <= 0x2ff) || (c >= 0x370 && c <= 0x37d) ||
           (c >= 0x37f && c <= 0x1fff) || (c >= 0x200c && c <= 0x200d) ||
           (c >= 0x2070 && c <= 0x218f) || (c >= 0x2c00 && c <= 0x2fef) ||
           (c >= 0x3001 && c <= 0xd7ff) || (c >= 0xf900 && c <= 0xfdcf) ||
           (c >= 0xfdf0 && c <= 0xfffd) || (c >= 0x10000 && c <= 0xeffff);
}
/* XML names retain qualified spelling; namespace resolution remains separate. */
static long XmlName(long pos)
{
    long next = pos;
    unsigned long c = XmlCode(&next);
    if (!XmlStart(c))
        return pos;
    do
    {
        pos = next;
        c = XmlCode(&next);
    } while (XmlStart(c) || c == '-' || c == '.' || (c >= '0' && c <= '9') ||
             c == 0xb7 || (c >= 0x300 && c <= 0x36f) || (c >= 0x203f && c <= 0x2040));
    return pos;
}
/* XML Char excludes surrogate code points, forbidden controls and noncharacters. */
static int XmlChar(unsigned long c)
{
    return c == 9 || c == 10 || c == 13 || (c >= 32 && c <= 0xd7ff) ||
           (c >= 0xe000 && c <= 0xfffd) || (c >= 0x10000 && c <= 0x10ffff);
}
/* Validate reference spelling and numeric scalar range, without resolving entities. */
static long XmlReference(long pos)
{
    long end;
    if (S_CurrentCh(++pos) != '#')
    {
        end = XmlName(pos);
        return end != pos && S_CurrentCh(end) == ';' ? end + 1 : -1;
    }
    {
        unsigned long value = 0;
        int base = 10, digit, count = 0, ch;
        ++pos;
        if (S_CurrentCh(pos) == 'x')
        {
            base = 16;
            ++pos;
        }
        while ((ch = S_CurrentCh(pos)) != ';')
        {
            digit = ch >= '0' && ch <= '9'   ? ch - '0'
                    : ch >= 'a' && ch <= 'f' ? ch - 'a' + 10
                    : ch >= 'A' && ch <= 'F' ? ch - 'A' + 10
                                             : -1;
            if (digit < 0 || digit >= base || value > (0x10ffffUL - digit) / base)
                return -1;
            value = value * base + digit;
            ++count;
            ++pos;
        }
        return count && XmlChar(value) ? pos + 1 : -1;
    }
}
/* A double hyphen is legal only as the final comment delimiter. */
static long XmlComment(long pos)
{
    while (S_CurrentCh(pos))
    {
        long next = pos;
        if (XmlAt(pos, "--"))
            return XmlAt(pos, "-->") ? pos + 3 : -1;
        if (!XmlChar(XmlCode(&next)))
            return -1;
        pos = next;
    }
    return -1;
}
/* Delimited XML markup has mandatory terminators, including at end of input. */
static long XmlUntil(long pos, const char *end)
{
    while (S_CurrentCh(pos))
    {
        if (XmlAt(pos, end))
            return pos + (long)strlen(end);
        {
            long next = pos;
            if (!XmlChar(XmlCode(&next)))
                return -1;
            pos = next;
        }
    }
    return -1;
}
/* Braces contain actual AS expressions, including nested XML/regexp literals. */
static long XmlInterpolation(long pos)
{
    as3_seek_source(pos + 1);
    Get();
    Expression();
    if (Sym != RbraceSym)
        return -1;
    return S_NextPos + S_NextLen;
}
/* XML element/list validation is bounded by the same nesting/work guard as AS.
 * A negative return is a syntax failure; no malformed tail is silently ignored. */
static long XmlElement(long pos)
{
    long open, open_end, close, close_end, next;
    int dynamic = 0, list = 0, ch;
    as3_syntax_enter();
    if (XmlAt(pos, "<!--"))
        next = XmlComment(pos + 4);
    else if (XmlAt(pos, "<![CDATA["))
        next = XmlUntil(pos + 9, "]]>");
    else if (XmlAt(pos, "<?"))
    {
        next = XmlName(pos + 2);
        if (next == pos + 2 || (XmlSpace(next) == next && !XmlAt(next, "?>")))
            next = -1;
        else if (next - pos == 5 &&
                 (S_CurrentCh(pos + 2) == 'x' || S_CurrentCh(pos + 2) == 'X') &&
                 (S_CurrentCh(pos + 3) == 'm' || S_CurrentCh(pos + 3) == 'M') &&
                 (S_CurrentCh(pos + 4) == 'l' || S_CurrentCh(pos + 4) == 'L'))
            next = -1;
        else
            next = XmlUntil(next, "?>");
    }
    else
    {
        open = ++pos;
        if (S_CurrentCh(pos) == '>')
        {
            list = 1;
            open_end = pos;
        }
        else if (S_CurrentCh(pos) == '{')
        {
            dynamic = 1;
            open_end = pos = XmlInterpolation(pos);
            if (pos < 0)
            {
                as3_syntax_leave();
                return -1;
            }
        }
        else
        {
            open_end = XmlName(pos);
            if (open_end == pos)
            {
                as3_syntax_leave();
                return -1;
            }
            pos = open_end;
        }
        for (;;)
        {
            next = XmlSpace(pos);
            if (XmlAt(next, "/>"))
            {
                as3_syntax_leave();
                return list ? -1 : next + 2;
            }
            if (S_CurrentCh(next) == '>')
            {
                pos = next + 1;
                break;
            }
            if (list || next == pos)
            {
                as3_syntax_leave();
                return -1;
            }
            pos = next;
            if (S_CurrentCh(pos) == '{')
                pos = XmlInterpolation(pos);
            else
            {
                next = XmlName(pos);
                if (next == pos)
                {
                    as3_syntax_leave();
                    return -1;
                }
                pos = next;
            }
            if (pos < 0)
            {
                as3_syntax_leave();
                return -1;
            }
            pos = XmlSpace(pos);
            if (S_CurrentCh(pos++) != '=')
            {
                as3_syntax_leave();
                return -1;
            }
            pos = XmlSpace(pos);
            ch = S_CurrentCh(pos);
            if (ch == '{')
                pos = XmlInterpolation(pos);
            else if (ch == 34 || ch == 39)
            {
                ++pos;
                while (S_CurrentCh(pos) && S_CurrentCh(pos) != ch &&
                       S_CurrentCh(pos) != '<')
                {
                    if (S_CurrentCh(pos) == '&')
                    {
                        pos = XmlReference(pos);
                        if (pos < 0)
                            break;
                    }
                    else
                    {
                        long end = pos;
                        if (!XmlChar(XmlCode(&end)))
                        {
                            pos = -1;
                            break;
                        }
                        pos = end;
                    }
                }
                if (pos < 0 || S_CurrentCh(pos++) != ch)
                {
                    as3_syntax_leave();
                    return -1;
                }
            }
            else
            {
                as3_syntax_leave();
                return -1;
            }
            if (pos < 0)
            {
                as3_syntax_leave();
                return -1;
            }
        }
        for (;;)
        {
            ch = S_CurrentCh(pos);
            if (!ch)
            {
                as3_syntax_leave();
                return -1;
            }
            if (XmlAt(pos, "</"))
            {
                close = pos + 2;
                if (S_CurrentCh(close) == '{')
                {
                    if (list)
                    {
                        as3_syntax_leave();
                        return -1;
                    }
                    close_end = XmlInterpolation(close);
                    if (close_end < 0)
                    {
                        as3_syntax_leave();
                        return -1;
                    }
                }
                else
                {
                    close_end = XmlName(close);
                    if ((!list && close_end == close) ||
                        (list && S_CurrentCh(close) != '>'))
                    {
                        as3_syntax_leave();
                        return -1;
                    }
                    if (!dynamic && (open_end - open != close_end - close))
                    {
                        as3_syntax_leave();
                        return -1;
                    }
                    if (!dynamic)
                    {
                        long i;
                        for (i = 0; i < open_end - open; ++i)
                            if (S_CurrentCh(open + i) != S_CurrentCh(close + i))
                            {
                                as3_syntax_leave();
                                return -1;
                            }
                    }
                }
                next = XmlSpace(close_end);
                if (S_CurrentCh(next) != '>')
                {
                    as3_syntax_leave();
                    return -1;
                }
                as3_syntax_leave();
                return next + 1;
            }
            if (ch == '<')
                pos = XmlElement(pos);
            else if (ch == '{')
                pos = XmlInterpolation(pos);
            else if (ch == '&')
                pos = XmlReference(pos);
            else if (XmlAt(pos, "]]>"))
                pos = -1;
            else
            {
                long end = pos;
                pos = XmlChar(XmlCode(&end)) ? end : -1;
            }
            if (pos < 0)
            {
                as3_syntax_leave();
                return -1;
            }
        }
    }
    as3_syntax_leave();
    return next;
}
/* Publish one complete XML literal as the consumed token span for later ASI. */
static void ReadXml(long start)
{
    int line = S_Line, column = S_Col;
    long end = XmlElement(start);
    if (end < 0)
    {
        SemError(1104);
        end = start;
        while (S_CurrentCh(end))
            ++end;
    }
    as3_seek_source(end);
    S_NextPos = start;
    S_NextLen = (int)(end - start);
    S_NextLine = line;
    S_NextCol = column;
    Get();
}

/* The regexp parser recognizes structure without compiling or executing a pattern.
 * Its input is the exact operand-goal span selected by the Coco/R parser. */
typedef struct
{
    long pos, end;
    unsigned flags, captures, reference, names, references;
    long name_start[512], name_end[512];
    long reference_start[512], reference_end[512];
} RegexInput;

/* Extended mode discards ASCII pattern whitespace and # comments outside classes. */
static void RegexSpace(RegexInput *input)
{
    if (!(input->flags & 16))
        return;
    while (input->pos < input->end)
    {
        int ch = S_CurrentCh(input->pos);
        if (ch == ' ' || (ch >= 9 && ch <= 13))
            ++input->pos;
        else if (ch == '#')
        {
            while (input->pos < input->end && S_CurrentCh(input->pos) != 10 &&
                   S_CurrentCh(input->pos) != 13)
                ++input->pos;
        }
        else
            break;
    }
}
/* Read an exact hexadecimal escape into a UTF-16 code unit. */
static int RegexHex(RegexInput *input, unsigned count, long *value)
{
    unsigned i;
    *value = 0;
    for (i = 0; i < count; ++i)
    {
        int ch, digit;
        if (input->pos >= input->end)
            return 0;
        ch = S_CurrentCh(input->pos++);
        digit = ch >= '0' && ch <= '9'   ? ch - '0'
                : ch >= 'a' && ch <= 'f' ? ch - 'a' + 10
                : ch >= 'A' && ch <= 'F' ? ch - 'A' + 10
                                         : -1;
        if (digit < 0)
            return 0;
        *value = *value * 16 + digit;
    }
    return 1;
}
/* Compare name spellings or arbitrary-length decimal bounds without overflow. */
static int RegexEqual(long a, long a_end, long b, long b_end)
{
    if (a_end - a != b_end - b)
        return 0;
    while (a < a_end)
        if (S_CurrentCh(a++) != S_CurrentCh(b++))
            return 0;
    return 1;
}
/* Named groups use ASCII identifier spelling; names are compared without allocation. */
static int RegexName(RegexInput *input, int closing, long *start, long *end)
{
    int ch;
    *start = input->pos;
    ch = S_CurrentCh(input->pos);
    if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_'))
        return 0;
    do
    {
        ch = S_CurrentCh(++input->pos);
    } while (input->pos < input->end &&
             ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
              (ch >= '0' && ch <= '9') || ch == '_'));
    *end = input->pos;
    if (input->pos >= input->end || ch != closing)
        return 0;
    ++input->pos;
    return 1;
}
/* Character escapes return -1 for a character set, a scalar for a single character.
 * Decimal references are counted after the complete pattern to permit forward refs. */
static int RegexEscape(RegexInput *input, int in_class, long *value)
{
    int ch;
    *value = -1;
    if (input->pos >= input->end)
        return 0;
    ch = S_CurrentCh(input->pos++);
    if (strchr("dDsSwW", ch))
        return 1;
    if (ch == 'x' || ch == 'u')
        return RegexHex(input, ch == 'x' ? 2 : 4, value);
    if (ch == 'c')
    {
        if (input->pos >= input->end)
            return 0;
        ch = S_CurrentCh(input->pos++);
        if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')))
            return 0;
        *value = ch & 31;
        return 1;
    }
    if (ch >= '0' && ch <= '9')
    {
        unsigned number = (unsigned)(ch - '0');
        if (in_class || ch == '0')
        {
            unsigned digits = 1;
            if (ch > '7')
                return 0;
            while (digits < (ch <= '3' ? 3u : 2u) && input->pos < input->end &&
                   S_CurrentCh(input->pos) >= '0' && S_CurrentCh(input->pos) <= '7')
            {
                number = number * 8 + S_CurrentCh(input->pos++) - '0';
                ++digits;
            }
            *value = number;
            return 1;
        }
        while (input->pos < input->end && S_CurrentCh(input->pos) >= '0' &&
               S_CurrentCh(input->pos) <= '9')
        {
            if (number > 99)
                return 0;
            number = number * 10 + S_CurrentCh(input->pos++) - '0';
        }
        if (number > input->reference)
            input->reference = number;
        return number <= 99;
    }
    if (!in_class && ch == 'k' && S_CurrentCh(input->pos) == '<')
    {
        unsigned n = input->references++;
        if (n >= 512)
            return 0;
        ++input->pos;
        return RegexName(input, '>', &input->reference_start[n],
                         &input->reference_end[n]);
    }
    *value = ch == 'n'   ? 10
             : ch == 'r' ? 13
             : ch == 't' ? 9
             : ch == 'f' ? 12
             : ch == 'v' ? 11
             : ch == 'b' ? 8
                         : ch;
    return 1;
}
/* A class range needs two single-character endpoints in ascending order. */
static int RegexClassAtom(RegexInput *input, long *value)
{
    unsigned long code;
    if (input->pos >= input->end)
        return 0;
    if (S_CurrentCh(input->pos) == 92)
    {
        ++input->pos;
        return RegexEscape(input, 1, value);
    }
    if (!IdentifierUnit(&input->pos, input->end, &code))
        return 0;
    *value = (long)code;
    return 1;
}
/* Class brackets, escape sequences and ranges have their own lexical context. */
static int RegexClass(RegexInput *input)
{
    if (S_CurrentCh(input->pos) == '^')
        ++input->pos;
    while (input->pos < input->end && S_CurrentCh(input->pos) != ']')
    {
        long first, last;
        if (!RegexClassAtom(input, &first))
            return 0;
        if (S_CurrentCh(input->pos) == '-' && input->pos + 1 < input->end &&
            S_CurrentCh(input->pos + 1) != ']')
        {
            ++input->pos;
            if (!RegexClassAtom(input, &last) || first < 0 || last < first)
                return 0;
        }
    }
    return input->pos < input->end && S_CurrentCh(input->pos++) == ']';
}
/* Decimal bounds are compared as digit spans rather than host-sized integers. */
static int RegexBounds(long first, long first_end, long last, long last_end)
{
    while (first + 1 < first_end && S_CurrentCh(first) == '0')
        ++first;
    while (last + 1 < last_end && S_CurrentCh(last) == '0')
        ++last;
    if (first_end - first != last_end - last)
        return first_end - first < last_end - last;
    while (first < first_end)
    {
        int a = S_CurrentCh(first++), b = S_CurrentCh(last++);
        if (a != b)
            return a < b;
    }
    return 1;
}
/* One quantifier may be followed by lazy ? or AS3's possessive + suffix. */
static int RegexQuantifier(RegexInput *input, int atom)
{
    int ch;
    RegexSpace(input);
    ch = input->pos < input->end ? S_CurrentCh(input->pos) : 0;
    if (ch != '*' && ch != '+' && ch != '?' && ch != '{')
        return 1;
    if (!atom)
        return 0;
    ++input->pos;
    if (ch == '{')
    {
        long first = input->pos, first_end, last, last_end;
        while (input->pos < input->end && S_CurrentCh(input->pos) >= '0' &&
               S_CurrentCh(input->pos) <= '9')
            ++input->pos;
        first_end = input->pos;
        if (first_end == first)
            return 0;
        if (S_CurrentCh(input->pos) == ',')
        {
            last = ++input->pos;
            while (input->pos < input->end && S_CurrentCh(input->pos) >= '0' &&
                   S_CurrentCh(input->pos) <= '9')
                ++input->pos;
            last_end = input->pos;
            if (last_end != last && !RegexBounds(first, first_end, last, last_end))
                return 0;
        }
        if (input->pos >= input->end || S_CurrentCh(input->pos++) != '}')
            return 0;
    }
    if (input->pos < input->end &&
        (S_CurrentCh(input->pos) == '?' || S_CurrentCh(input->pos) == '+'))
        ++input->pos;
    return 1;
}
static int RegexExpression(RegexInput *input);
/* Groups recurse under the existing parser guard; no unbounded C recursion. */
static int RegexGroup(RegexInput *input, int *atom)
{
    int ch;
    if (S_CurrentCh(input->pos) == '?')
    {
        ++input->pos;
        ch = S_CurrentCh(input->pos++);
        if (ch == '=' || ch == '!')
            *atom = 0;
        else if (ch == '<')
        {
            ch = S_CurrentCh(input->pos++);
            if (ch != '=' && ch != '!')
                return 0;
            *atom = 0;
        }
        else if (ch == 'P' && S_CurrentCh(input->pos) == '<')
        {
            unsigned i, n = input->names++;
            if (n >= 512)
                return 0;
            ++input->pos;
            if (!RegexName(input, '>', &input->name_start[n], &input->name_end[n]))
                return 0;
            for (i = 0; i < n; ++i)
                if (RegexEqual(input->name_start[i], input->name_end[i],
                               input->name_start[n], input->name_end[n]))
                    return 0;
            ++input->captures;
        }
        else if (ch == 'P' && S_CurrentCh(input->pos) == '=')
        {
            unsigned n = input->references++;
            if (n >= 512)
                return 0;
            ++input->pos;
            return RegexName(input, ')', &input->reference_start[n],
                             &input->reference_end[n]);
        }
        else if (ch != ':' && ch != '>')
            return 0;
    }
    else
        ++input->captures;
    if (!RegexExpression(input))
        return 0;
    if (input->pos >= input->end || S_CurrentCh(input->pos++) != ')')
        return 0;
    return 1;
}
/* Disjunction, alternatives, assertions, atoms and quantifiers follow E3 order. */
static int RegexExpression(RegexInput *input)
{
    int ok = 1;
    as3_syntax_enter();
    while (ok)
    {
        int ch, atom = 1;
        long value;
        RegexSpace(input);
        if (input->pos >= input->end || S_CurrentCh(input->pos) == ')')
            break;
        ch = S_CurrentCh(input->pos++);
        if (ch == '|')
            continue;
        if (ch == '^' || ch == '$')
            atom = 0;
        else if (ch == '(')
            ok = RegexGroup(input, &atom);
        else if (ch == '[')
            ok = RegexClass(input);
        else if (ch == 92)
        {
            ch = S_CurrentCh(input->pos);
            if (ch == 'b' || ch == 'B')
            {
                ++input->pos;
                atom = 0;
            }
            else
                ok = RegexEscape(input, 0, &value);
        }
        else if (strchr("*+?{}]", ch))
            ok = 0;
        if (ok)
            ok = RegexQuantifier(input, atom);
    }
    as3_syntax_leave();
    return ok;
}
/* Resolve references after parsing so forward group references remain possible. */
static int RegexPattern(long start, long end, unsigned flags)
{
    RegexInput input;
    unsigned i, j;
    memset(&input, 0, sizeof(input));
    input.pos = start;
    input.end = end;
    input.flags = flags;
    if (!RegexExpression(&input) || input.pos != end ||
        input.reference > input.captures)
        return 0;
    for (i = 0; i < input.references; ++i)
    {
        for (j = 0; j < input.names; ++j)
            if (RegexEqual(input.reference_start[i], input.reference_end[i],
                           input.name_start[j], input.name_end[j]))
                break;
        if (j == input.names)
            return 0;
    }
    return 1;
}

CHARACTERS
  /* Байты имён: ASCII и старшие байты UTF-8. Это не таблица категорий Unicode. */
  letter =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_$" +
    CHR(128) .. CHR(255)
  .

  /* Десятичные цифры. */
  digit =
    "0123456789"
  .

  /* Шестнадцатеричные цифры. */
  hex =
    digit + "abcdefABCDEF"
  .

  /* Содержимое двойных кавычек без переводов строки и обратной косой черты. */
  dq =
    ANY - '"' - "\\" - CHR(10) - CHR(13) - CHR(0)
  .

  /* Содержимое одинарных кавычек без разделителей и переводов строки. */
  sq =
    ANY - "'" - "\\" - CHR(10) - CHR(13) - CHR(0)
  .

  /* Байты однострочного комментария; исключён EOF, поэтому допустим конец без LF. */
  linechar =
    ANY - CHR(10) - CHR(13) - CHR(0)
  .

  /* Байт после обратной косой черты; интерпретация escape — будущий проход. */
  escaped =
    ANY - CHR(0) - CHR(10) - CHR(13)
  .

  /* Части блочного комментария: конечный разделитель не должен исчезать в теле.
  Завершающий разделитель обязателен в токене, поэтому EOF без него — ошибка. */
  nonstar =
    ANY - "*" - CHR(0)
  .

  nonstarslash =
    ANY - "*" - "/" - CHR(0)
  .

  /* Physical line breaks are permitted only in escaped string continuations. */
  cr =
    CHR(13)
  .

  lf =
    CHR(10)
  .

TOKENS
  /* Идентификатор. Ключевые слова выделяются таблицей литералов Coco/R. */
  /* Identifier escapes remain visible in the source span; scalar/category
  checks are performed by the C hook declared above, before grammar decisions. */
  ident =
    (
        letter
        | "\\" "u" hex hex hex hex
    )
    {
        letter
        | digit
        | "\\" "u" hex hex hex hex
    }
  .

  /* Десятичное число с необязательной дробной частью и экспонентой. */
  number =
    (
        digit
        {
            digit
        }
        [
            "."
            {
                digit
            }
        ]
        | "." digit
        {
            digit
        }
    )
    [
        (
            "e"
            | "E"
        )
        [
            "+"
            | "-"
        ]
        digit
        {
            digit
        }
    ]
  .

  /* Целое число AS с префиксом 0x или 0X. */
  hexnum =
    "0"
    (
        "x"
        | "X"
    )
    hex
    {
        hex
    }
  .

  /* Строковый литерал; кавычки и обратная косая черта не поглощаются как текст. */
  text =
    '"'
    {
        dq
        | "\\"
        (
            escaped
            | cr
            [
                lf
            ]
            | lf
        )
    }
    '"'
    | "'"
    {
        sq
        | "\\"
        (
            escaped
            | cr
            [
                lf
            ]
            | lf
        )
    }
    "'"
  .

PRAGMAS
  /* Полный ненестинговый комментарий, включая обязательный закрывающий разделитель. */
  blockcomment =
    "/*"
    {
        nonstar
        | "*"
        {
            "*"
        }
        nonstarslash
    }
    "*"
    {
        "*"
    }
    "/"
  .

  /* Комментарий пропускается как pragma и не попадает в правила синтаксиса. */
  linecomment =
    "//"
    {
        linechar
    }
  .

IGNORE
  CHR(9) + lf + cr
  /* Entry: consume the entire translation unit, including trailing-token checks. */

PRODUCTIONS
  /* Полная единица ввода AS3; декларации классов отделены от инструкций. */
  As3 =
    {
        Package
        | Item
    }
    EOF
  .

  /* Package may be anonymous; qualified names use the ordinary type spelling. */
  Package =
    "package"
    [
        QualifiedName
    ]
    "{"
    {
        Item
    }
    "}"
  .

  /* Элемент программы или тела: выбор между декларацией и инструкцией. */
  Item =
    IF(Sym == identSym && ConfigBlockAhead()) ConfigBlock
    |
    IF(Sym == identSym && WordAt(S_NextPos, "include") &&
       (S_CurrentCh(Trivia(S_NextPos + S_NextLen)) == 34 ||
        S_CurrentCh(Trivia(S_NextPos + S_NextLen)) == 39))
    IncludeDirective
    | Import
    | IF(Sym == LbrackSym && MetadataAhead()) MetadataDeclaration
    | IF(DeclarationAhead(Sym)) Declaration
    | UseNamespace
    | Statement
  .

  /* Namespace guard blocks preserve ordinary item syntax, without evaluation. */
  ConfigBlock =
                                                                        (. as3_syntax_enter(); .)
    Identifier "::" Identifier Block                                    (. as3_syntax_leave(); .)
  .

  /* Class guards contain members, rather than executable statement lists. */
  ConfigMembers =
                                                                        (. as3_syntax_enter(); .)
    Identifier "::" Identifier "{"
    {
        IF(MemberAhead(Sym)) Member
    }
    "}"                                                                 (. as3_syntax_leave(); .)
  .

  /* Contextual include accepts a filename but never reads a host file.
  Calls/variables named include remain ordinary ActionScript expressions. */
  IncludeDirective =
    Identifier text Terminator
  .

  /* Блок ограничивает последовательность элементов фигурными скобками. */
  Block =
    "{"
    {
        Item
    }
    "}"
  .

  /* Инструкции языка. Метка проверяется до выражения; блок и объявление
  функции выбираются явно, чтобы не спутать их с object/function expression.
  Условие перед else связывает его с ближайшим незавершённым if. */
  Statement =
                                                                        (. as3_syntax_enter(); .)
    (
        IF(Sym == identSym && LabelAhead()) Identifier ":" Statement
        | IF(Sym == LbraceSym) Block
        | ";"
        |
        (
            "var"
            | "const"
        )
        Variables Terminator
        | IF(Sym == functionSym) "function" Identifier FunctionTail
        | IF(Sym == defaultSym && DefaultXmlAhead()) "default"
        Identifier                                                      (.
                                                                            if (!WordAt(S_Pos, "xml"))
                                                                                SemError(1104);
                                                                        .)
        "namespace" "=" Expression Terminator
        | IfStatement
        | WhileStatement
        | ForStatement
        | SwitchStatement
        | TryStatement
        | "return"
        [
            IF(!LineBreak() && Sym != SemicolonSym && Sym != RbraceSym && Sym != EOF_Sym)
            Expression
        ]
        Terminator
        | "throw"                                                       (.
                                                                            if (LineBreak())
                                                                                SemError(1102);
                                                                        .)
        Expression Terminator
        |
        (
            "break"
            | "continue"
        )
        [
            IF(Sym == identSym && !LineBreak()) Identifier
        ]
        Terminator
        | "with" "(" Expression ")" Statement
        | Expression Terminator
    )
                                                                        (. as3_syntax_leave(); .)
  .

  /* else относится к ближайшему if; предикат не потребляет токен. */
  IfStatement =
    "if" "(" Expression ")" Statement
    [
        IF(Sym == elseSym) "else" Statement
    ]
  .

  /* Проверка до тела и проверка после тела используют одно правило Statement. */
  WhileStatement =
    "while" "(" Expression ")" Statement
    | "do" Statement "while" "(" Expression ")" Terminator
  .

  /* Suppress relational in until the for-in separator is decided. The saved
  * mode makes nested for/function/group parses independent of their caller. */
  ForStatement =
                                                                        (. int outer = allow_in, each = 0; .)
    "for"
    [
        IF(Sym==identSym && WordAt(S_NextPos,"each")) Identifier        (. each = 1; .)
    ]
    "("                                                                 (. allow_in = 0; .)
    [
        (
            "var"
            | "const"
        )
        Variables
        | Expression
    ]
                                                                        (. allow_in = outer; .)
    (
        "in" Expression ")" Statement
        | ";"                                                           (.
                                                                            if (each)
                                                                                SemError(1202);
                                                                        .)
        [
            Expression
        ]
        ";"
        [
            Expression
        ]
        ")" Statement
    )
  .

  /* Метки и тела ветвей вынесены в SwitchPart для читаемости. */
  SwitchStatement =
    "switch" "(" Expression ")" "{"
    {
        SwitchPart
    }
    "}"
  .

  /* try обязан иметь catch или finally; допускается их сочетание. */
  TryStatement =
    "try" Block
    (
        CatchClause
        {
            CatchClause
        }
        [
            "finally" Block
        ]
        | "finally" Block
    )
  .

  /* Multiple typed handlers are preserved in source order; types are not resolved. */
  CatchClause =
    "catch" "(" Identifier
    [
        ":" TypeName
    ]
    ")" Block
  .

  /* Метка case/default и её инструкции; следующая метка начинает новую ветвь. */
  SwitchPart =
    (
        "case" Assignment ":"
        | "default" ":"
    )
    {
        IF(Sym != caseSym && Sym != RbraceSym && Sym != EOF_Sym &&
           (Sym != defaultSym || DefaultXmlAhead()))
        Item
    }
  .

  /* Список объявляемых переменных; запятая разделяет декларации, а не выражения. */
  Variables =
    Variable
    {
        "," Variable
    }
  .

  /* Имя переменной, необязательный тип AS3 и необязательный инициализатор. */
  Variable =
    Identifier
    [
        ":" TypeName
    ]
    [
        "=" Assignment
    ]
  .

  /* Параметры, необязательный возвращаемый тип AS3 и тело функции. */
  FunctionTail =
                                                                        (. int outer = allow_in; .)
    Parameters
    [
        ":" ReturnType
    ]
                                                                        (. allow_in = 1; .)
    Block                                                               (. allow_in = outer; .)
  .

  /* Iteration avoids stack growth with the number of parameters. Local flags
  * enforce optional ordering and reject every parameter after rest. */
  Parameters =
                                                                        (. int optional = 0, rest = 0; .)
    "("
    [
        ParameterItem<&optional,&rest>
        {
            "," ParameterItem<&optional,&rest>
        }
    ]
    ")"
  .

  /* Reject misplaced rest while still consuming the item for error recovery. */
  ParameterItem<int *optional, int *rest> =
                                                                        (.
                                                                            if (*rest)
                                                                                SemError(1203);
                                                                        .)
    "..." Identifier
    [
        ":" TypeName
    ]
                                                                        (. *rest = 1; .)
    | Parameter<optional>
  .

  /* Default-expression constness/type checking belongs to future semantics. */
  Parameter<int *optional> =
                                                                        (. int has_default = 0; .)
    Identifier
    [
        ":" TypeName
    ]
    [
        "=" Assignment                                                  (. has_default = 1; .)
    ]
                                                                        (.
                                                                            if (*optional && !has_default)
                                                                                SemError(1201);
                                                                            if (has_default)
                                                                                *optional = 1;
                                                                        .)
  .

  /* Самый низкий приоритет: последовательность выражений через запятую. */
  Expression =
    Assignment
    {
        "," Assignment
    }
  .

  /* Присваивание разбирается рекурсией справа: a = b = c.
  Проверка допустимости левой части относится к будущему семантическому проходу. */
  Assignment =
                                                                        (. as3_syntax_enter(); .)
    (
        Conditional
        [
            IF(Sym == EqualSym || Sym == PlusEqualSym || Sym == MinusEqualSym ||
               Sym == StarEqualSym || Sym == SlashEqualSym || Sym == PercentEqualSym ||
               Sym == LessLessEqualSym || Sym == GreaterGreaterEqualSym ||
               Sym == GreaterGreaterGreaterEqualSym || Sym == AndEqualSym ||
               Sym == BarEqualSym || Sym == UparrowEqualSym)
            AssignOp Assignment
        ]
    )
                                                                        (. as3_syntax_leave(); .)
  .

  /* Обычное и составные присваивания; конкретные операции сохраняются в токенах. */
  AssignOp =
    "="
    | "+="
    | "-="
    | "*="
    | "/="
    | "%="
    | "<<="
    | ">>="
    | ">>>="
    | "&="
    | "|="
    | "^="
  .

  /* Тернарный оператор. Правая ветвь рекурсивна, поэтому a?b:c?d:e
  группируется как a?b:(c?d:e); средняя ветвь допускает присваивание. */
  Conditional =
                                                                        (. as3_syntax_enter(); .)
    (
        LogicalOr
        [
            "?" Assignment ":" Conditional
        ]
    )
                                                                        (. as3_syntax_leave(); .)
  .

  /* Логическое ИЛИ; более сильные операторы разбираются внутри LogicalAnd. */
  LogicalOr =
    LogicalAnd
    {
        "||" LogicalAnd
    }
  .

  /* Логическое И; следующий уровень — побитовое ИЛИ. */
  LogicalAnd =
    BitOr
    {
        "&&" BitOr
    }
  .

  /* Побитовое ИЛИ. Повторение задаёт левую ассоциативность этого уровня. */
  BitOr =
    BitXor
    {
        "|" BitXor
    }
  .

  /* Побитовое исключающее ИЛИ; операнды имеют более высокий приоритет. */
  BitXor =
    BitAnd
    {
        "^" BitAnd
    }
  .

  /* Побитовое И; сравнения равенства связываются сильнее. */
  BitAnd =
    Equality
    {
        "&" Equality
    }
  .

  /* Сравнения равенства; каждый операнд сначала проходит относительные сравнения. */
  Equality =
    Relational
    {
        (
            "=="
            | "!="
            | "==="
            | "!=="
        )
        Relational
    }
  .

  /* Относительные сравнения; операции сдвига имеют более высокий приоритет. */
  Relational =
    Shift
    {
        IF(RelationalAhead(Sym))
        (
            "<"
            | ">"
            | "<="
            | ">="
            | "instanceof"
            | "is"
            | "as"
            | "in"
        )
        Shift
    }
  .

  /* Сдвиги; сложение и вычитание разбираются до выполнения сдвига. */
  Shift =
    Additive
    {
        (
            "<<"
            | ">>"
            | ">>>"
        )
        Additive
    }
  .

  /* Сложение/вычитание: повторение — левая ассоциативность, Product — сильнее. */
  Additive =
    Product
    {
        IF(Sym == PlusSym || Sym == MinusSym)
        (
            "+"
            | "-"
        )
        Product
    }
  .

  /* Умножение, деление и остаток: операнды разбираются как унарные выражения. */
  Product =
    Unary
    {
        IF(Sym == StarSym || Sym == SlashSym || Sym == PercentSym)
        (
            "*"
            | "/"
            | "%"
        )
        Unary
    }
  .

  /* Префиксные операции рекурсивны; Postfix отвечает за вызовы и обращения. */
  Unary =
                                                                        (. as3_syntax_enter(); .)
    (
        (
            "!"
            | "~"
            | "+"
            | "-"
            | "++"
            | "--"
            | "typeof"
            | "void"
            | "delete"
        )
        Unary
        | "new"
        (
            IF(Sym == LessSym) VectorLiteral PostfixTail
            | Unary
        )
        | Postfix
    )
                                                                        (. as3_syntax_leave(); .)
  .

  /* Цепочка обращений к полям, индексирования и вызовов; затем ++ или --. */
  Postfix =
    Primary PostfixTail
  .

  /* A vector initializer has the same following property/call/index syntax. */
  PostfixTail =
    {
        IF(Sym == PointSym || Sym == PointPointSym || Sym == LbrackSym || Sym == LparenSym)
        (
            "."
            (
                "<" TypeName TypeClose
                | "(" Expression ")"
                | XmlProperty
            )
            | ".." XmlProperty
            | Subscript
            | Arguments
        )
    }
    [
        IF(!LineBreak() && (Sym == PlusPlusSym || Sym == MinusMinusSym))
        (
            "++"
            | "--"
        )
    ]
  .

  /* Аргументы разделены запятыми; запятая внутри аргумента требует скобок. */
  Arguments =
                                                                        (. int outer = allow_in; .)
    "("                                                                 (. allow_in = 1; .)
    [
        Assignment
        {
            "," Assignment
        }
    ]
    ")"                                                                 (. allow_in = outer; .)
  .

  /* Атомы выражений: литералы, имена, группировка и составные литералы. */
  Primary =
                                                                        (. as3_syntax_enter(); .)
    (
        Identifier
        [
            "::" XmlProperty
        ]
        | "@" XmlSelector
        | "*" "::" XmlSelector
        | number
        | hexnum
        | Regexp
        | XmlLiteral
        | text
        | "true"
        | "false"
        | "null"
        | "undefined"
        | "this"
        | "super"
        | GroupedExpression
        | ArrayLiteral
        | ObjectLiteral
        | "function"
        [
            Identifier
        ]
        FunctionTail
    )
                                                                        (. as3_syntax_leave(); .)
  .

  /* Subscripts and literal contents use ordinary expressions, even in NoIn. */
  Subscript =
                                                                        (. int outer = allow_in; .)
    "["                                                                 (. allow_in = 1; .)
    Expression "]"                                                      (. allow_in = outer; .)
  .

  /* Vector initializers require values; array holes do not denote typed values. */
  VectorLiteral =
    "<" TypeName TypeClose "["
    [
        Assignment
        {
            IF(Sym == CommaSym &&
        S_CurrentCh(Trivia(S_NextPos + S_NextLen)) != ']')
            "," Assignment
        }
        [
            ","
        ]
    ]
    "]"
  .

  /* Array holes remain allowed; commas do not become expression operators. */
  ArrayLiteral =
                                                                        (. int outer = allow_in; .)
    "["                                                                 (. allow_in = 1; .)
    [
        Assignment
    ]
    {
        ","
        [
            Assignment
        ]
    }
    "]"                                                                 (. allow_in = outer; .)
  .

  /* Object property initializers restore the surrounding NoIn mode afterwards. */
  ObjectLiteral =
                                                                        (. int outer = allow_in; .)
    "{"                                                                 (. allow_in = 1; .)
    [
        Property
        {
            "," Property
        }
    ]
    "}"                                                                 (. allow_in = outer; .)
  .

  /* Parentheses admit in even inside a NoIn initializer. */
  GroupedExpression =
                                                                        (. int outer = allow_in; .)
    "("                                                                 (. allow_in = 1; .)
    Expression ")"                                                      (. allow_in = outer; .)
  .

  /* Ключ и значение свойства object literal; разделитель — двоеточие. */
  Property =
    (
        PropertyName
        | text
        | number
        | hexnum
    )
    ":" Assignment
  .

  /* Квалифицированное имя типа AS3; разрешение имени будет отдельным проходом. */
  TypeName =
                                                                        (. as3_syntax_enter(); .)
    (
        QualifiedName
        [
            "." "<" TypeName TypeClose
        ]
        | "*"
    )
                                                                        (. as3_syntax_leave(); .)
  .

  /* void is only a return annotation, never a class/variable/parameter type. */
  ReturnType =
    TypeName
    | "void"
  .

  /* Qualified declaration names cannot be wildcard or void. */
  QualifiedName =
    Identifier
    {
        IF(Sym == PointSym && !TypeArgumentsAhead()) "." Identifier
    }
    [
        "::" Identifier
    ]
  .

  /* Импорт AS3; допускается последняя компонента-звёздочка. */
  Import =
    "import" Identifier
    {
        "."
        (
            Identifier
            | "*"
        )
    }
    Terminator
  .

  /* Factor modifiers before class/interface to keep the grammar LL(1). */
  Declaration =
    {
        IF(ModifierAhead(Sym)) Modifier
    }
    (
        "class" Identifier
        [
            "extends" QualifiedName
        ]
        [
            "implements" QualifiedName
            {
                "," QualifiedName
            }
        ]
        "{"
        {
            IF(MemberAhead(Sym)) Member
        }
        "}"
        | "interface" Identifier
        [
            "extends" QualifiedName
            {
                "," QualifiedName
            }
        ]
        "{"
        {
            Signature
        }
        "}"
        | "function" MethodName FunctionTail
        |
        (
            "var"
            | "const"
        )
        Variables Terminator
        | NamespaceDeclaration
    )
  .

  /* Namespace resolution/visibility are not performed by a syntax frontend. */
  NamespaceDeclaration =
    "namespace" Identifier
    [
        "="
        (
            text
            | QualifiedName
        )
    ]
    Terminator
  .

  /* Contextual namespace selection does not make arbitrary identifiers modifiers. */
  UseNamespace =
    "use" "namespace" QualifiedName Terminator
  .

  /* Модификаторы AS3; допустимость их сочетаний проверяется семантически. */
  Modifier =
    "public"
    | "private"
    | "static"
    | "dynamic"
    | "protected"
    | "internal"
    | "override"
    | "final"
    | IF(Sym==identSym && CustomModifierAhead()) Identifier
  .

  /* Поле или метод класса; дополнительное имя используется для get/set. */
  Member =
    IF(Sym == identSym && ConfigBlockAhead()) ConfigMembers
    |
    {
        Metadata
    }
    {
        IF(ModifierAhead(Sym)) Modifier
    }
    (
        (
            "var"
            | "const"
        )
        Variables Terminator
        | "function" MethodName FunctionTail
        | NamespaceDeclaration
        | UseNamespace
        | ";"
    )
  .

  /* Сигнатура метода интерфейса завершается точкой с запятой вместо тела. */
  Signature =
    "function" MethodName Parameters
    [
        ":" ReturnType
    ]
    Terminator
  .

  /* Only get/set admit a second identifier; f g() is rejected. */
  MethodName =
                                                                        (. int accessor = 0; .)
    Identifier                                                          (. accessor = AccessorName(); .)
    [
        IF(Sym==identSym && accessor) Identifier
    ]
  .

  /* Metadata attributes precede a declaration, never an arbitrary statement. */
  MetadataDeclaration =
    Metadata
    {
        Metadata
    }
    Declaration
  .

  /* Attribute arguments are assignment expressions; constness is a later semantic check. */
  Metadata =
    "[" QualifiedName
    [
        "("
        [
            Assignment
            {
                "," Assignment
            }
        ]
        ")"
    ]
    "]"
  .

  /* In type context >>, >>> and their assignment forms close nested generics one > at a time. */
  TypeClose =
                                                                        (.
                                                                            if (S_CurrentCh(S_NextPos) == '>')
                                                                            {
                                                                                as3_split_greater();
                                                                                Sym = GreaterSym;
                                                                            }
                                                                        .)
    ">"
  .

  /* Reserved words are legal property names after a dot and in object literal keys. */
  PropertyName =
    ident
    | "class"
    | "interface"
    | "function"
    | "var"
    | "const"
    | "public"
    | "private"
    | "protected"
    | "internal"
    | "static"
    | "dynamic"
    | "override"
    | "final"
    | "namespace"
    | "use"
    | "import"
    | "package"
    | "extends"
    | "implements"
    | "if"
    | "else"
    | "for"
    | "while"
    | "do"
    | "switch"
    | "case"
    | "default"
    | "try"
    | "catch"
    | "finally"
    | "throw"
    | "return"
    | "break"
    | "continue"
    | "with"
    | "new"
    | "delete"
    | "typeof"
    | "void"
    | "instanceof"
    | "in"
    | "is"
    | "as"
    | "true"
    | "false"
    | "null"
    | "undefined"
    | "this"
    | "super"
  .

  /* Regexp is scanned only when an operand is expected; division remains an operator. */
  Regexp =
                                                                        (.
                                                                            long pattern_end;
                                                                            unsigned flags;
                                                                            if (!as3_scan_regexp(&pattern_end, &flags) ||
                                                                                !RegexPattern(S_NextPos + 1, pattern_end, flags))
                                                                                SynError(1103);
                                                                        .)
    (
        "/"
        | "/="
    )
  .

  /* XML literals switch lexical goals only after an expression's opening <. */
  XmlLiteral =
                                                                        (. long start = S_NextPos; .)
    "<"                                                                 (. ReadXml(start); .)
  .

  /* Attributes, wildcards, namespace selectors and computed E4X properties. */
  XmlProperty =
    [
        "@"
    ]
    XmlSelector
  .

  /* Qualified and computed selector without a second attribute prefix. */
  XmlSelector =
    (
        PropertyName
        | "*"
        | "[" Expression "]"
    )
    [
        "::"
        (
            PropertyName
            | "*"
            | "[" Expression "]"
        )
    ]
  .

  /* Automatic insertion is allowed at a line break, before } or at EOF.
  An explicit semicolon always wins; for-header separators remain mandatory. */
  Terminator =
                                                                        (. int explicit_semi = 0; .)
    [
        IF(Sym == SemicolonSym) ";"                                     (. explicit_semi = 1; .)
    ]
                                                                        (.
                                                                            if (!explicit_semi && Sym != RbraceSym && Sym != EOF_Sym && !LineBreak())
                                                                                SemError(1101);
                                                                        .)
  .

  /* A binding/expression identifier cannot decode to a reserved word. */
  Identifier =
    ident                                                               (.
                                                                            if (IdentifierReserved(S_Pos, S_Len))
                                                                                SemError(1106);
                                                                        .)
  .

END
  As3
  .

