/* AS2 display-profile lowering to FIR; all parsing is generated by Coco/R.
 * Unsupported AS syntax is rejected rather than silently emitted as VM code. */
COMPILER View
#include "emit.h"

CHARACTERS
    /* Portable source bindings; runtime string values may contain arbitrary Unicode. */
    letter = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_".
    /* Decimal digits shared by binding suffixes and integer constants. */
    digit = "0123456789".
    /* Complete line comments are skipped as pragmas, including at EOF. */
    linechar = ANY - CHR(10) - CHR(13).

TOKENS
    /* One global or member name; the emitter independently enforces its length. */
    ident = letter {letter | digit}.
    /* Nonnegative decimal integer; the emitter rejects int32 overflow. */
    number = digit {digit}.

PRAGMAS
    /* Do not confuse source comments with the shared FIR output's source notes. */
    linecomment = "//" {linechar}.

IGNORE CHR(9) + CHR(10) + CHR(13) + CHR(32)

PRODUCTIONS
    /* A nonempty complete unit: trailing unsupported tokens may not disappear. */
    View =
        Assignment
        { Assignment }
        EOF
    .

    /* Capture the LHS object before the RHS; explicit semicolons define this profile. */
    Assignment =                                                        (. int member = 0; .)
        ident                                                           (. emit_target(); .)
        [
            "." ident                                                 (.
                                                                            emit_property();
                                                                            member = 1;
                                                                        .)
        ]
        "=" Expression ";"                                            (. emit_assign(member); .)
    .

    /* Standard left-associative addition/subtraction; AS Add2 remains dynamic. */
    Expression =
        Product
        {
            "+" Product                                               (. emit_binary(0); .)
            | "-" Product                                             (. emit_binary(1); .)
        }
    .

    /* Numeric multiply/divide bind more tightly and lower explicit coercions. */
    Product =
        Value
        {
            "*" Value                                                 (. emit_binary(2); .)
            | "/" Value                                               (. emit_binary(3); .)
        }
    .

    /* Identifiers read AS bindings; constants become typed FIR SSA values. */
    Value =
        ident                                                           (. emit_global(); .)
        | number                                                        (. emit_number(); .)
        | "true"                                                       (. emit_boolean(1); .)
        | "false"                                                      (. emit_boolean(0); .)
    .
END View.
