/* AS2 display-profile lowering to FIR; all parsing is generated by Coco/R.
 * Unsupported AS syntax is rejected rather than silently emitted as VM code. */
COMPILER View
#include "emit.h"

CHARACTERS
    /* Portable source bindings; runtime string values may contain arbitrary Unicode. */
    letter = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_".
    /* Decimal digits shared by binding suffixes and integer constants. */
    digit = "0123456789".
    /* Complete line comments are skipped as pragmas, including at EOF. */
    linechar = ANY - CHR(10) - CHR(13).
    /* Raw bytes of a UTF-8 string, leaving escape syntax explicit. */
    stringchar = CHR(32)..CHR(126) + CHR(128)..CHR(255) - '"' - "\\".
    /* Escapes shared with FIR's canonical text format. */
    escaped = '"' + "\\" + "nrt".

TOKENS
    /* One global or member name; the emitter independently enforces its length. */
    ident = letter {letter | digit}.
    /* Nonnegative decimal integer; the emitter rejects int32 overflow. */
    number = digit {digit}.
    /* Double-quoted AS string admitted by this lowering profile. */
    string = '"' {stringchar | "\\" escaped} '"'.

PRAGMAS
    /* Do not confuse source comments with the shared FIR output's source notes. */
    linecomment = "//" {linechar}.

IGNORE CHR(9) + CHR(10) + CHR(13) + CHR(32)

PRODUCTIONS
    /* EN: A complete initializer or one timeline callback.
     * RU: Полный инициализатор или обработчик шкалы времени. */
    View =
        ( FrameHandler | (. emit_initializer(); .) Statements )
        EOF
    .

    /* EN: Install one named root method with an empty parameter list.
     * RU: Установить именованный метод корня с пустым списком параметров. */
    FrameHandler =
        "function" ident                                                (. emit_frame_handler(); .)
        "(" ")" "{" Statements "}"
    .

    /* EN: Lower a nonempty sequence of statements, each with a balanced expression stack.
     * RU: Понизить непустую последовательность инструкций, сохраняющих баланс стека. */
    Statements =
        Statement { Statement }
    .

    /* EN: Dispatch by the first token to an assignment or a braced conditional.
     * RU: Выбрать присваивание или ветвление с блоками по первому токену. */
    Statement =
        Assignment
        | Conditional
        | WhileLoop
    .

    /* EN: Reevaluate the condition before each iteration.
     * RU: Вычислять условие перед каждой итерацией. */
    WhileLoop =                                                         (. int label; .)
        "while"                                                         (. label = emit_while(); .)
        "(" Expression ")"                                              (. emit_while_test(label); .)
        "{" [ Statements ] "}"                                          (. emit_while_end(label); .)
    .

    /* EN: Terminate each arm at a distinct merge block; optional else may be empty.
     * RU: Замкнуть каждую ветвь блоком слияния; else можно опустить. */
    Conditional =                                                       (. int label; .)
        "if" "(" Expression ")"                                        (. label = emit_if(); .)
        "{" [ Statements ] "}"                                         (. emit_else(label); .)
        [ "else" "{" [ Statements ] "}" ]
                                                                        (. emit_merge(label); .)
    .

    /* Capture the LHS object before the RHS; explicit semicolons define this profile. */
    Assignment =                                                        (. int member = 0; .)
        [ "var" ] ident                                                 (. emit_target(); .)
        [
            "." ident                                                 (.
                                                                            emit_property();
                                                                            member = 1;
                                                                        .)
        ]
        "=" Expression ";"                                            (. emit_assign(member); .)
    .

    /* Standard left-associative addition/subtraction; AS Add2 remains dynamic. */
    Expression =
        Product
        {
            "+" Product                                               (. emit_binary(0); .)
            | "-" Product                                             (. emit_binary(1); .)
        }
    .

    /* Numeric multiply/divide bind more tightly and lower explicit coercions. */
    Product =
        Unary
        {
            "*" Unary                                                 (. emit_binary(2); .)
            | "/" Unary                                               (. emit_binary(3); .)
        }
    .

    /* EN: Logical negation binds before arithmetic and associates right-to-left.
     * RU: Логическое отрицание связывается до арифметики и вычисляется справа налево. */
    Unary =
        "!" Unary                                                      (. emit_not(); .)
        | Value
    .

    /* Read a binding or call one of its methods; literals become typed SSA values. */
    Value =
        IF(emit_ref_ahead()) ident ident                                (. char binding[256]; int member = 0;
                                                                           emit_method_name(binding); .)
        [ "." ident                                                     (. emit_ref(binding, 1); member = 1; .) ]
                                                                        (. if (!member) emit_ref(binding, 0); .)
        | ident                                                         (. emit_global(); .)
        [ Method ]
        | number                                                        (. emit_number(); .)
        | string                                                        (. emit_string(); .)
        | "true"                                                       (. emit_boolean(1); .)
        | "false"                                                      (. emit_boolean(0); .)
        | "(" Expression ")"
    .

    /* The receiver is already on the expression stack when argument evaluation starts. */
    Method =                                                            (. char key[256] = {0};
                                                                          int argc = 0; .)
        "." ident                                                       (. emit_method_name(key); .)
        "("
        [ Expression                                                    (. argc = 1; .)
          { "," Expression                                              (. ++argc; .) }
        ]
        ")"                                                             (. emit_method_call(key, argc); .)
    .
END View.
