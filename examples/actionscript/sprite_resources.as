/* Учебный пример: два независимых экземпляра экспортированного спрайта Hero.
 * До запуска хост загружает SWF через fvm_movieclip_load_swf; Hero должен
 * присутствовать в ExportAssets и иметь метку second в своём таймлайне.
 * Это исходник AS1/AS2 для компилятора SWF, а не вход текстового парсера FlashVM.
 */

/* [GC:] Сохраняем текущий MovieClip как родителя для новых экземпляров. */
var rootClip = this;
/* Готовим initObject: его перечисляемые свойства копируются до вызова зарегистрированного конструктора. */
var initial = {
    /* Свойство seed со значением 31 будет доступно конструктору прикрепляемого клипа. */
    seed: 31
/* Завершаем объект начальных значений. */
};
/* [GC:] Hero — linkage ID, leftHero — имя экземпляра, 32 — глубина, initial — начальные свойства. */
var left = rootClip.attachMovie("Hero", "leftHero", 32, initial);
/* [GC:] Создаём второй Hero с именем rightHero на глубине 33 и собственным состоянием кадров. */
var right = rootClip.attachMovie("Hero", "rightHero", 33);
/* Неизвестный linkage ID возвращает undefined; проверяем оба результата перед обращением к методам. */
if (left == undefined || right == undefined) {
    /* Объясняем, какой ресурс хост должен экспортировать в загружаемом SWF. */
    trace("Export the Hero sprite before running this example.");
/* В успешной ветке работаем с обоими созданными экземплярами. */
} else {
    /* second — метка кадра левого экземпляра; переход ставит его на паузу. */
    left.gotoAndStop("second");
    /* Правый экземпляр продолжает проигрываться независимо от остановленного левого. */
    right.play();
    /* [GC:] Создаём копию right как соседа rightCopy на глубине 34 с initial; копия начинает с кадра 1. */
    var copied = right.duplicateMovieClip("rightCopy", 34, initial);
    /* Проверяем возвращённую ссылку перед чтением её свойств. */
    if (copied != undefined) {
        /* seed скопирован из initial, а не из динамических переменных оригинала right. */
        trace(copied.seed);
    /* Завершаем проверку результата дублирования. */
    }
    /* Читаем глубину левого экземпляра: она равна выбранному значению 32. */
    trace(left.getDepth());
/* Завершаем проверку результатов прикрепления; кадры далее двигает планировщик хоста. */
}
