/* Experimental source adapters, also generated with bhgv/coco-r-C.
 * This grammar intentionally accepts only the documented tutorial subset.
 * Generated globals belong to fir1_source, separate from the FIR parser. */
COMPILER Src1
#include "lower.h"
/* Only scanner access lives here; C99 lowering is in lower.c. */
static void capture(void)
{
    char text[256] = "";
    if (S_Len < 256) S_GetString(S_Pos, S_Len, text, 255);
    source_token(text, S_Line, S_Len >= 256);
}
static int depth;
CHARACTERS
  /* Portable module identifiers. */
  letter = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_" .
  /* Decimal literals with exponent; division is outside this subset. */
  digit = "0123456789" .
  /* Comment bytes excluding EOF and line delimiters. */
  linebyte = ANY - CHR(0) - CHR(10) - CHR(13) .
  /* Non-nesting block comment components. */
  nonstar = ANY - "*" - CHR(0) .
  nonstarslash = ANY - "*" - "/" - CHR(0) .
TOKENS
  /* Module name; keywords are distinguished by the generated scanner. */
  ident = letter {letter | digit} .
  /* Nonnegative number; unary minus belongs to Primary. */
  numeral = digit {digit} ["." digit {digit}]
            [("e" | "E") ["+" | "-"] digit {digit}] .
PRAGMAS
  /* Human-readable tutorial comments are ignored by parsing. */
  linecomment = "//" {linebyte} .
  /* Closing delimiter is required, including at EOF. */
  blockcomment = "/*" {nonstar | "*" {"*"} nonstarslash} "*" {"*"} "/" .
IGNORE CHR(9) + CHR(10) + CHR(13)
PRODUCTIONS
  /* Entire input must match exactly one supported tutorial profile. */
  Src1 = ( TraceProgram | LimboProgram ) EOF .
  /* Numeric statements have one function-wide binding environment. */
  TraceProgram = (. source_language(0); .) Statement {Statement} .
  /* Initialized declaration, assignment or trace. No implicit globals. */
  Statement = (. int name = 0, value = 0; .)
      ( "trace" "(" Expression<&value> ")" ";" (. source_trace(value); .)
      | "var" Name<&name> [ ":" ident (. capture(); source_annotation(); .) ]
        "=" Expression<&value> ";" (. source_bind(name, value, 1); .)
      | Name<&name> "=" Expression<&value> ";" (. source_bind(name, value, 0); .) ) .
  /* Intern a source identifier separately from reading its current binding. */
  Name<int *name> = ident (. capture(); *name = source_name(); .) .
  /* Limbo value() is a tutorial entry, not the Inferno loader ABI. */
  LimboProgram = (. int value = 0; source_language(1); .)
      "implement" ident (. capture(); source_module(1); .) ";"
      ident (. capture(); source_module(0); .)
      ":" "module" "{" "value" ":" "fn" "(" ")" ":" "int" ";" "}" ";"
      "value" "(" ")" ":" "int" "{" {LimboStatement}
      "return" Expression<&value> ";" "}" (. source_trace(value); .) .
  /* Explicit initialized int declarations and reassignment, in source order. */
  LimboStatement = (. int name = 0, value = 0; .)
      Name<&name>
      ( ":" "int" "=" Expression<&value> ";" (. source_bind(name, value, 1); .)
      | "=" Expression<&value> ";" (. source_bind(name, value, 0); .) ) .
  /* Addition/subtraction bind less tightly than multiplication, left to right. */
  Expression<int *result> = (. int right = 0, op = 0; .)
      Product<result>
      { ("+" (. op = '+'; .) | "-" (. op = '-'; .)) Product<&right>
        (. *result = source_binary(*result, right, op); .) } .
  /* Multiplication is left associative. */
  Product<int *result> = (. int right = 0; .)
      Primary<result> { "*" Primary<&right> (. *result = source_binary(*result, right, '*'); .) } .
  /* Parentheses recurse only within the documented 64-level limit.
   * The resolver tests depth without consuming tokens. Minus applies to a
   * literal, not an arbitrary subexpression, in this first subset. */
  Primary<int *result> = (. int negative = 0, name = 0; .)
      ( IF(Sym == LparenSym && depth < 64) "(" (. ++depth; .) Expression<result> ")" (. --depth; .)
      | Name<&name> (. *result = source_read(name); .)
      | ["-" (. negative = 1; .)] numeral (. capture(); *result = source_constant(negative); .) ) .
END Src1.
