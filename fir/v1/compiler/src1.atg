/* Experimental source adapters, also generated with bhgv/coco-r-C.
 * This grammar intentionally accepts only the documented tutorial subset.
 * Generated globals belong to fir1_source, separate from the FIR parser. */
COMPILER Src1
#include "lower.h"

/* Copy the previous scanner token into semantic storage, including its source span.
 * No arguments or ownership transfer. Oversized tokens become sticky diagnostics. */
static void capture(void)
{
    char text[256] = "";
    if (S_Len < 256)
    {
        S_GetString(S_Pos, S_Len, text, 255);
    }
    source_token(text, S_Line, S_Pos, (size_t)S_Len, S_Len >= 256);
}

/* Ask the semantic catalog about exactly one scanner-produced lookahead token.
 * Return boolean without consuming input or scanning source syntax a second time. */
static int AliasAhead(void)
{
    char text[256] = "";
    if (S_NextLen >= 256)
    {
        return 0;
    }
    S_GetString(S_NextPos, S_NextLen, text, 255);
    return source_alias_named(text);
}


static int depth; /* Bounded parser recursion; reset for every source module. */


/* Find the next nontrivia byte after the current lookahead token.
 * Return a borrowed scanner position; never consume tokens or allocate. The
 * generated scanner remains responsible for reporting malformed comments. */
static long AfterToken(void)
{
    long pos = S_NextPos + S_NextLen;
    for (;;)
    {
        int ch = S_CurrentCh(pos);
        int next = S_CurrentCh(pos + 1);
        if (ch == ' ' || ch == 9 || ch == 10 || ch == 13)
        {
            ++pos;
        }
        else if (ch == '#' || (ch == '/' && next == '/'))
        {
            while (S_CurrentCh(pos) && S_CurrentCh(pos) != 10)
            {
                ++pos;
            }
        }
        else if (ch == '/' && next == '*')
        {
            pos += 2;
            while (S_CurrentCh(pos) && !(S_CurrentCh(pos) == '*' && S_CurrentCh(pos + 1) == '/'))
            {
                ++pos;
            }
            if (!S_CurrentCh(pos))
            {
                return pos;
            }
            pos += 2;
        }
        else
        {
            return pos;
        }
    }
}


/* Select snapshot for-in after one name followed by comma or the keyword in.
 * Borrow scanner trivia/bytes without consuming them; distinguish in from an
 * identifier prefix such as inbox. Coco/R parses every actual header token. */
static int ForInAhead(int token)
{
    long pos = AfterToken();
    int boundary = S_CurrentCh(pos + 2);
    int namebyte = (boundary >= 'A' && boundary <= 'Z') ||
                   (boundary >= 'a' && boundary <= 'z') ||
                   (boundary >= '0' && boundary <= '9') || boundary == '_';
    return (token == identSym || token == valueSym || token == realSym) &&
           (S_CurrentCh(pos) == ',' ||
            (S_CurrentCh(pos) == 'i' && S_CurrentCh(pos + 1) == 'n' && !namebyte));
}


/* Recognize a numeric operand after a sign without consuming scanner input.
 * Return boolean; ordinary unary expressions keep the shared recursion bound. */
static int LiteralAhead(void)
{
    long pos = AfterToken();
    int ch = S_CurrentCh(pos);
    int next = S_CurrentCh(pos + 1);
    return (ch >= '0' && ch <= '9') || (ch == '.' && next >= '0' && next <= '9');
}


/* Resolve a constructor's bare-name field without treating == as assignment.
 * Return boolean using borrowed scanner bytes; the expression grammar still
 * parses every key/value and evaluates ordinary identifier expressions. */
static int NamedFieldAhead(void)
{
    long pos = AfterToken();
    return S_CurrentCh(pos) == '=' && S_CurrentCh(pos + 1) != '=';
}


/* Distinguish a separator from one trailing comma, including intervening trivia.
 * Return boolean; an empty/repeated field remains a generated-parser error. */
static int MoreFieldsAhead(void)
{
    return S_CurrentCh(AfterToken()) != '}';
}

CHARACTERS
  /* Portable module identifiers. */
  letter =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"
  .

  /* Decimal digits for literals with optional fraction and exponent. */
  digit =
    "0123456789"
  .

  /* Hexadecimal digits for ActionScript literals. */
  hex =
    digit + "abcdefABCDEF"
  .

  /* Radix digits are checked against the selected base by C99 lowering. */
  alpha =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
  .

  /* Comment bytes excluding EOF and line delimiters. */
  linebyte =
    ANY - CHR(0) - CHR(10) - CHR(13)
  .

  /* Non-nesting block comment components. */
  nonstar =
    ANY - "*" - CHR(0)
  .

  nonstarslash =
    ANY - "*" - "/" - CHR(0)
  .

  /* Table keys use the existing FIR escape set; NUL strings are not silently truncated. */
  quotedbyte = ANY - '"' - "\\" - CHR(0) - CHR(10) - CHR(13).
  escaped = '"' + "\\nrt".

TOKENS
  /* Explicit copied UTF-8 key, validated before lowering. */
  textlit = '"' { quotedbyte | "\\" escaped } '"'.
  /* Module name; keywords are distinguished by the generated scanner. */
  ident =
    letter
    {
        letter
        | digit
    }
  .

  /* Nonnegative number; unary minus belongs to Primary. */
  numeral =
    (
        digit
        {
            digit
        }
        [
            "."
            {
                digit
            }
        ]
        | "." digit
        {
            digit
        }
    )
    [
        (
            "e"
            | "E"
        )
        [
            "+"
            | "-"
        ]
        digit
        {
            digit
        }
    ]
  .

  /* Hex belongs to AS; explicit radix belongs to Limbo. Semantic checks reject
  * the wrong language rather than silently choosing different arithmetic. */
  hexnum =
    "0"
    (
        "x"
        | "X"
    )
    hex
    {
        hex
    }
  .

  radix =
    digit
    {
        digit
    }
    (
        "r"
        | "R"
    )
    (
        digit
        | alpha
    )
    {
        digit
        | alpha
    }
  .

  /* Prevent ++/-- from being silently read as two unary operators. */
  increment =
    "++"
    | "--"
  .

PRAGMAS
  /* Native Limbo comments; their use in AS profiles is a semantic error. */
  hashcomment =
    "#"
    {
        linebyte
    }
  .

                                                                        (.
                                                                            source_token("", S_NextLine, S_NextPos, (size_t)S_NextLen, 0);
                                                                            source_hash_comment();
                                                                        .)
  /* Human-readable tutorial comments are ignored by parsing. */
  linecomment =
    "//"
    {
        linebyte
    }
  .

  /* Closing delimiter is required, including at EOF. */
  blockcomment =
    "/*"
    {
        nonstar
        | "*"
        {
            "*"
        }
        nonstarslash
    }
    "*"
    {
        "*"
    }
    "/"
  .

IGNORE
  CHR(9) + CHR(10) + CHR(13)

PRODUCTIONS
  /* Entire input must match exactly one supported tutorial profile. */
  Src1 =
    (
        TraceProgram
        | LimboProgram
    )
    EOF
  .

  /* Empty statements emit no instruction; at least one statement is required. */
  TraceProgram =
                                                                        (.
                                                                            depth = 0;
                                                                            source_language(0);
                                                                        .)
    Statement
    {
        Statement
    }
  .

  /* Declarations bind left-to-right; assignment is a statement, not an expression. */
  Statement =
                                                                        (.
                                                                            int name = 0, value = 0, op = 0;
                                                                            SourceMark target;
                                                                        .)
    (
        "trace" "(" Expression<&value> ")" ";"                          (. source_trace(value); .)
        | ASDeclaration ";"
        | Name<&name>                                                   (. target = source_mark(); .)
        AssignmentOperator<&op> Expression<&value> ";"                  (.
                                                                            source_restore(target);
                                                                            source_assign(name, value, op);
                                                                        .)
        | ";"
    )
  .

  /* AS3 const is enforced by the binding table, not merely accepted as spelling. */
  ASDeclaration =
                                                                        (. int constant = 0; .)
    (
        "var"
        | "const"                                                       (. constant = 1; .)
    )
    Binding<constant>
    {
        "," Binding<constant>
    }
  .

  /* Every numeric binding needs an initializer in this restricted profile. */
  Binding<int constant> =
                                                                        (.
                                                                            int name = 0, value = 0;
                                                                            SourceMark target;
                                                                        .)
    Name<&name>                                                         (. target = source_mark(); .)
    [
        ":" ident                                                       (.
                                                                            capture();
                                                                            source_annotation();
                                                                        .)
    ]
    "=" Expression<&value>                                              (.
                                                                            source_restore(target);
                                                                            source_declare(name, value, constant);
                                                                        .)
  .

  /* Homogeneous Limbo int supports checked /= and %=; AS remainder stays rejected. */
  AssignmentOperator<int *op> =
    (
        "=" (. *op = 0; .)
        | "+=" (. *op = '+'; .)
        | "-=" (. *op = '-'; .)
        | "*=" (. *op = '*'; .)
        | "/=" (. *op = '/'; .)
        | "%=" (. *op = '%'; .)
        | "&=" (. *op = '&'; .)
        | "|=" (. *op = '|'; .)
        | "^=" (. *op = '^'; .)
        | "<<=" (. *op = '<'; .)
        | ">>=" (. *op = '>'; .)
    )
    (. capture(); .)
  .

  /* Intern a source identifier separately from reading its current binding. */
  Name<int *name> =
    (
        ident
        | "real"
        | "type"
        | "value"
    )
                                                                        (.
                                                                            capture();
                                                                            *name = source_name();
                                                                        .)
  .

  /* Save a statement's head without assigning it to the value namespace.
   * The colon branch distinguishes a local type declaration before interning. */
  BindingHead =
    (ident | "real" | "type" | "value")
    (.
        capture();
        source_alias_header();
    .)
  .

  /* Limbo value() is a tutorial entry, not the Inferno loader ABI. */
  LimboProgram =
                                                                        (.
                                                                            int header = 0;
                                                                            depth = 0;
                                                                            source_language(1);
                                                                        .)
    "implement" ident                                                   (.
                                                                            capture();
                                                                            source_module(1);
                                                                        .)
    ";"
    /* Stop after the module header; requiring an identifier guarantees EOF progress. */
    { IF(!header && Sym==identSym) LimboHeader<&header> }
    (. source_alias_module(header); .)
    "{" { LimboAlias } (. source_alias_validate(); .) "value" ":" "fn" "(" ")" ":" ResultType<1> ";"
    "}" ";" "value" "(" ")" ":" ResultType<0> "{" (. source_alias_body(); .)
    FlowBody "}"
    (.
        capture();
        source_flow_finish();
    .)
  .

  /* A factored header distinguishes earlier file aliases from the module without
   * rescanning bytes or adding recursive C frames per declaration. */
  LimboHeader<int *module> =
    (. int type = T_VOID; .)
    ident (. capture(); source_alias_header(); .) ":"
    (
        "type" AliasTarget<&type> ";" (. source_alias_declare((FirType)type); .)
        | "module" (. source_module(0); source_alias_scope(1); *module = 1; .)
    )
  .

  /* Module aliases precede value() and remain visible to its implementing body. */
  LimboAlias =
    (. int type = T_VOID; .)
    ident (. capture(); source_alias_header(); .) ":" "type" AliasTarget<&type> ";"
    (. source_alias_declare((FirType)type); .)
  .

  /* Save named edges. The complete prefix resolves forwards/cycles; a local
   * declaration resolves its edge immediately in the current lexical scope. */
  AliasTarget<int *type> =
    "int" (. *type = T_I32; .)
    | "real" (. *type = T_F64; .)
    | "big" (. *type = T_I64; .)
    | "string" (. *type = T_STRING; .)
    | "table" "of" "big" (. *type = T_TABLE_BIG; .)
    | ident (. capture(); *type = source_alias_target(); .)
  .

  /* The interface records the numeric result type; the definition must match it.
  * Keeping this choice in Coco/R avoids scanning source text for type keywords. */
  ResultType<int declaration> =
    "int"                                                               (. capture(); source_result_type(0, declaration); .)
    | "real"                                                            (. capture(); source_result_type(1, declaration); .)
    | "big" (. capture(); source_result_type(2, declaration); .)
    | ident (. capture(); source_result_alias(declaration); .)
  .

  /* Locals stay homogeneous: explicit int/real conversions are not implemented. */
  BindingType =
    "int"                                                               (. capture(); source_binding_type(0); .)
    | "real"                                                            (. capture(); source_binding_type(1); .)
    | ident (. capture(); source_binding_alias(); .)
  .

  /* Numeric conditions compose strict relations lazily. && binds above ||;
   * bool values never become numeric source bindings or implicit truthiness. */
  LimboCondition<SourceCondition *condition> =
    (.
        int value = 0;
    .)
    Expression<&value>
    (.
        *condition = source_table_truth(value);
    .)
  .

  /* Guard each disjunction RHS before emitting its arithmetic or comparisons. */
  NumericLogicalOr<int *result> =
    (.
        int right = 0;
        SourceLogic logic;
        SourceMark operation;
    .)
    NumericLogicalAnd<result>
    {
        "||"
        (.
            capture();
            operation = source_mark();
            logic = source_logic_begin(*result, 1);
        .)
        NumericLogicalAnd<&right>
        (.
            source_restore(operation);
            *result = source_logic_end(logic, right);
        .)
    }
  .

  /* Guard each conjunction RHS and retain exact authored operator provenance. */
  NumericLogicalAnd<int *result> =
    (.
        int right = 0;
        SourceLogic logic;
        SourceMark operation;
    .)
    NumericBitOr<result>
    {
        "&&"
        (.
            capture();
            operation = source_mark();
            logic = source_logic_begin(*result, 0);
        .)
        NumericBitOr<&right>
        (.
            source_restore(operation);
            *result = source_logic_end(logic, right);
        .)
    }
  .

  /* Equality binds below ordering and above bitwise AND, as in Limbo.
   * Bool equality is admitted only between normalized intermediate conditions. */
  NumericEquality<int *result> =
    (.
        int right = 0;
        SourceRelation relation = SOURCE_EQUAL;
        SourceMark operation;
    .)
    NumericOrdering<result>
    {
        (
            "==" (. relation = SOURCE_EQUAL; .)
            | "!=" (. relation = SOURCE_NOT_EQUAL; .)
        )
        (.
            capture();
            operation = source_mark();
        .)
        NumericOrdering<&right>
        (.
            source_restore(operation);
            *result = source_numeric_relation(*result, right, relation);
        .)
    }
  .

  /* Ordered comparisons retain exact numeric types and source operand order.
   * Chained comparisons parse normally; an ordered bool operand rejects later. */
  NumericOrdering<int *result> =
    (.
        int right = 0;
        SourceRelation relation = SOURCE_LESS;
        SourceMark operation;
    .)
    IntegerShift<result>
    {
        (
            "<" (. relation = SOURCE_LESS; .)
            | ">" (. relation = SOURCE_GREATER; .)
            | "<=" (. relation = SOURCE_LESS_EQUAL; .)
            | ">=" (. relation = SOURCE_GREATER_EQUAL; .)
        )
        (.
            capture();
            operation = source_mark();
        .)
        IntegerShift<&right>
        (.
            source_restore(operation);
            *result = source_numeric_relation(*result, right, relation);
        .)
    }
  .

  /* Limbo inferred declarations and initialized int declarations stay distinct
  * from reassignment. The IF resolvers consume an over-budget brace without
  * descent, and otherwise admit bounded block recursion. Neither may leave an
  * opening brace unconsumed in the enclosing statement repetition.
  * No arbitrary module loader ABI is implied. */
  LimboStatement =
    ";"
    | IF(Sym==LbraceSym && depth>=64) "{"
      (.
          capture();
          source_scope_limit();
      .)
    | IF(Sym==LbraceSym && depth<64) LimboBlock
    | NumericBinding<1> ";"
  .

  /* Delimiter-free numeric binding shared by statements and counted headers.
   * Header aliases reject; staged step declarations reject in the binding API. */
  NumericBinding<int allow_alias> =
    (.
        int name = 0;
        int value = 0;
        int op = 0;
        int direction = 0;
        int type = T_VOID;
        SourceMark target;
        SourceMark operation;
    .)
    BindingHead (. target = source_mark(); .)
    (
        ":"
        (
            "type" AliasTarget<&type>
            (. source_alias_local((FirType)type, allow_alias); .)
            | (. name = source_alias_value_name(); .)
              BindingType "=" Expression<&value>
              (.
                  source_restore(target);
                  source_bind(name, value, 1);
              .)
        )
        | (. name = source_alias_value_name(); .)
          (
              ":=" Expression<&value>
              (.
                  source_restore(target);
                  source_bind(name, value, 1);
              .)
              | TableIncrementOperator<&direction>
                (.
                    operation = source_mark();
                    source_restore(target);
                    source_numeric_increment(name, direction, operation);
                .)
              | AssignmentOperator<&op> (. operation = source_mark(); .) Expression<&value>
              (.
                  source_restore(target);
                  source_assign_at(name, value, op, operation);
              .)
          )
    )
  .

  /* Limbo braces delimit lexical bindings; writes to outer bindings persist.
  * The shared nesting budget bounds blocks, groups and unary recursion. */
  LimboBlock =
    "{"                                                                 (.
                                                                            ++depth;
                                                                            capture();
                                                                            source_enter_scope();
                                                                        .)
    FlowBody
    "}"                                                                 (.
                                                                            capture();
                                                                            source_leave_scope();
                                                                            --depth;
                                                                        .)
  .

  /* Every parenthesized expression uses this same precedence hierarchy.
   * Semantic guards keep intermediate bools out of numeric bindings/results. */
  Expression<int *result> =
    NumericLogicalOr<result>
  .

  /* Union is the lowest bit level; each operand evaluates once, left to right. */
  NumericBitOr<int *result> =
    (.
        int right = 0;
        SourceMark operation;
    .)
    IntegerXor<result>
    {
        "|"
        (.
            capture();
            operation = source_mark();
        .)
        IntegerXor<&right>
        (.
            source_restore(operation);
            *result = source_integer_bits(*result, right, '|');
        .)
    }
  .

  /* Exclusive-or binds more tightly than union and associates left. */
  IntegerXor<int *result> =
    (.
        int right = 0;
        SourceMark operation;
    .)
    IntegerAnd<result>
    {
        "^"
        (.
            capture();
            operation = source_mark();
        .)
        IntegerAnd<&right>
        (.
            source_restore(operation);
            *result = source_integer_bits(*result, right, '^');
        .)
    }
  .

  /* Intersection binds more tightly than exclusive-or; shifts bind above it. */
  IntegerAnd<int *result> =
    (.
        int right = 0;
        SourceMark operation;
    .)
    NumericEquality<result>
    {
        "&"
        (.
            capture();
            operation = source_mark();
        .)
        NumericEquality<&right>
        (.
            source_restore(operation);
            *result = source_integer_bits(*result, right, '&');
        .)
    }
  .

  /* Shifts bind below sums; runtime counts must be int 0..31 on every VM. */
  IntegerShift<int *result> =
    (.
        int right = 0;
        int direction = 0;
        SourceMark operation;
    .)
    NumericSum<result>
    {
        ( "<<" (. direction = '<'; .) | ">>" (. direction = '>'; .) )
        (.
            capture();
            operation = source_mark();
        .)
        NumericSum<&right>
        (.
            source_restore(operation);
            *result = source_integer_bits(*result, right, direction);
        .)
    }
  .

  /* Sums associate left and retain the existing arithmetic semantics. */
  NumericSum<int *result> =
                                                                        (.
                                                                            int right = 0, op = 0;
                                                                            SourceMark operator;
                                                                        .)
    Product<result>
    {
        (
            "+"                                                         (.
                                                                            op = '+';
                                                                            capture();
                                                                            operator = source_mark();
                                                                        .)
            | "-"                                                       (.
                                                                            op = '-';
                                                                            capture();
                                                                            operator = source_mark();
                                                                        .)
        )
        Product<&right>                                                 (.
                                                                            source_restore(operator);
                                                                            *result = source_binary(*result, right, op);
                                                                        .)
    }
  .

  /* Products associate left; int division/remainder are checked, AS division stays binary64. */
  Product<int *result> =
                                                                        (.
                                                                            int right = 0, op = 0;
                                                                            SourceMark operator;
                                                                        .)
    Unary<result>
    {
        (
            "*"                                                         (.
                                                                            op = '*';
                                                                            capture();
                                                                            operator = source_mark();
                                                                        .)
            | "/"                                                       (.
                                                                            op = '/';
                                                                            capture();
                                                                            operator = source_mark();
                                                                        .)
            | "%"                                                       (.
                                                                            op = '%';
                                                                            capture();
                                                                            operator = source_mark();
                                                                        .)
        )
        Unary<&right>                                                   (.
                                                                            source_restore(operator);
                                                                            *result = source_binary(*result, right, op);
                                                                        .)
    }
  .

  /* Signed literal branches preserve INT32_MIN; other unary chains are bounded.
   * An exact catalog alias selects a prefix cast before the ordinary value-name arm.
   * An over-budget alias consumes its head and reports the shared nesting limit;
   * admitted casts require depth<64, sharing the group/unary budget. */
  Unary<int *result> =
    (.
        int negative = 0;
        FirType cast = T_VOID;
        SourceMark operation;
    .)
    IF(Sym==MinusSym && LiteralAhead()) "-" Literal<result,1>
    | IF(Sym==PlusSym && LiteralAhead()) "+" Literal<result,0>
    | IF((Sym==PlusSym || Sym==MinusSym) && depth<64)
    (
        "+"
        | "-"                                                           (. negative = 1; .)
    )
    (.
        capture();
        operation = source_mark();
        ++depth;
    .)
    Unary<result>                                                       (.
                                                                            --depth;
                                                                            source_restore(operation);
                                                                            *result = negative ? source_negate(*result) : source_numeric_identity(*result);
                                                                        .)
    | IF(Sym==identSym && AliasAhead() && depth>=64)
      ident
      (.
          capture();
          source_scope_limit();
          *result = 0;
      .)
    | IF(Sym==identSym && AliasAhead() && depth<64)
      ident
      (.
          capture();
          operation = source_mark();
          cast = source_alias_type();
          ++depth;
      .)
      Unary<result>
      (.
          --depth;
          source_restore(operation);
          *result = source_alias_cast(*result, cast);
      .)
    | IF(Sym==TildeSym && depth<64) "~"
      (.
          capture();
          operation = source_mark();
          ++depth;
      .)
      Unary<result>
      (.
          --depth;
          source_restore(operation);
          *result = source_integer_not(*result);
      .)
    | IF(Sym==TildeSym && depth>=64) "~" (. capture(); source_scope_limit(); *result = 0; .)
    | IF(Sym==BangSym && depth>=64) "!"
    (.
        capture();
        source_scope_limit();
        *result = 0;
    .)
    | IF(Sym==BangSym && depth<64) "!"
    (.
        capture();
        operation = source_mark();
        ++depth;
    .)
    Unary<result>
    (.
        --depth;
        source_restore(operation);
        *result = source_table_not(*result);
    .)
    | Primary<result>
  .

  /* The shared literal path always captures the complete consumed token. */
  Literal<int *result,int negative> =
    (
        numeral
        | hexnum
        | radix
    )
                                                                        (.
                                                                            capture();
                                                                            *result = source_constant(negative);
                                                                        .)
  .

  /* Groups and unary operators share a maximum nesting of 64. */
  Primary<int *result> =
                                                                        (. int name = 0; .)
    IF(Sym==LparenSym && depth<64) "("                                  (. ++depth; .)
    Expression<result> ")"                                              (. --depth; .)
    | Name<&name>                                                       (. *result = source_read(name); .)
    | Literal<result,0>
  .

  /* Conditions borrow an already normalized expression result; no implicit truthiness. */
  TableCondition<SourceCondition *condition> =
    (. int value = 0; .)
    TableExpression<&value> (. *condition = source_table_truth(value); .)
  .

  /* Capture local bindings or table receiver/key once, then read the old value
   * before a compound RHS. Plain assignment remains insertion-capable and does
   * not read a missing/uninitialized destination. Arithmetic retains its op span. */
  TableStatement =
    (. int value = 0; .)
    LoopTransfer
    | TableFor
    | TableWhile
    | TableDelete<&value> ";"
    | TableBindingStatement<1> ";"
    | FlowBlock
  .

  /* Reusable header clause; the enclosing grammar owns its delimiter. */
  TableForClause =
    (. int value = 0; .)
    TableDelete<&value>
    | TableBindingStatement<0>
  .

  TableBindingStatement<int allow_alias> =
    (.
        int name = 0;
        int value = -1;
        int type = 0;
        int key = 0;
        int slot = 0;
        int receiver = 0;
        int end = 0;
        int slice = 0;
        int old = 0;
        int op = 0;
        int direction = 0;
        SourceMark target;
        SourceMark access;
        SourceMark operation;
    .)
    BindingHead (. target = source_mark(); .)
    (
        ":"
        (
            "type" AliasTarget<&type> (. source_alias_local((FirType)type, allow_alias); .)
            | (. name = source_alias_value_name(); .)
              TableType<&type> [ "=" TableExpression<&value> ]
              (.
                  source_restore(target);
                  source_table_bind(name, value, type, 1);
              .)
        )
        | (. name = source_alias_value_name(); .)
        (
            ":=" TableExpression<&value>
            (.
                source_restore(target);
                source_table_bind(name, value, 0, 1);
            .)
            | TableIncrementOperator<&direction>
            (.
                operation = source_mark();
                source_restore(target);
                old = source_read(name);
                source_restore(operation);
                value = source_table_increment(old, direction);
                source_restore(target);
                source_table_bind(name, value, 0, 0);
            .)
            | TableAssignmentOperator<&op>
            (.
                operation = source_mark();
                source_restore(target);
                if (op)
                {
                    old = source_read(name);
                }
            .)
            TableExpression<&value>
            (.
                source_restore(operation);
                if (op)
                {
                    value = source_table_update(old, value, op);
                }
                source_restore(target);
                source_table_bind(name, value, 0, 0);
            .)
            |
            (.
                source_restore(target);
                receiver = source_read(name);
                source_table_lease(receiver, 1);
            .)
            TableWriteKey<&key,&end,&slice,&access>
            (.
                source_restore(access);
                if (!slice && source_string_receiver(receiver))
                {
                    slot = source_string_char_range(receiver, key);
                    slice = 2;
                }
                else
                {
                    slot = slice ? source_table_range(receiver, key, end) : source_table_index(receiver, key);
                }
            .)
            (
                TableIncrementOperator<&direction>
                (.
                    operation = source_mark();
                    if (slice)
                    {
                        source_table_slice_compound();
                    }
                    old = source_table_load(slot);
                    source_restore(operation);
                    value = source_table_increment(old, direction);
                    source_restore(access);
                    source_table_store(slot, value);
                .)
                |
                TableAssignmentOperator<&op>
                (.
                    operation = source_mark();
                    if (op)
                    {
                        if (slice)
                        {
                            source_table_slice_compound();
                        }
                        else
                        {
                            old = source_table_load(slot);
                        }
                    }
                .)
                TableExpression<&value>
                (.
                    source_restore(operation);
                    if (op)
                    {
                        value = source_table_update(old, value, op);
                    }
                    else
                    {
                        source_restore(access);
                    }
                    if (slice)
                    {
                        if (slice == 2)
                        {
                            value = source_string_rune(value);
                        }
                        value = source_table_splice(slot, value);
                        if (value >= 0)
                        {
                            source_restore(target);
                            source_table_bind(name, value, 0, 0);
                        }
                    }
                    else
                    {
                        source_table_store(slot, value);
                    }
                .)
            )
            (.
                source_restore(target);
                source_table_lease(receiver, 0);
            .)
        )
    )
  .

  /* Loops re-evaluate conditions and carry typed locals through private cells.
   * Body-local declarations are retired before continuation. No implicit return. */
  TableWhile =
    IF(Sym==whileSym && depth>=64) "while" (.
          capture();
          source_scope_limit();
      .)
    | IF(Sym==whileSym && depth<64)
    (.
        int loop = 0;
        SourceCondition condition;
        SourceMark operation;
    .)
    "while"
    (.
        capture();
        operation = source_mark();
        loop = source_loop_begin();
    .)
    "(" FlowCondition<&condition> ")"
    (.
        source_restore(operation);
        ++depth;
        source_loop_condition(loop, condition);
    .)
    "{"
    (.
        capture();
        source_enter_scope();
    .)
    FlowBody
    "}" (. capture(); .)
    (.
        source_leave_scope();
        source_restore(operation);
        source_loop_end(loop);
        --depth;
    .)
  .

  /* FlashVM extension: one immutable key snapshot, live typed values per pass.
   * Bindings shadow only after the receiver has evaluated in the outer scope. */
  TableFor =
    IF(Sym==forSym && depth>=64) "for" (.
          capture();
          source_scope_limit();
      .)
    | IF(Sym==forSym && depth<64)
    (. SourceMark operation; .)
    "for"
    (.
        capture();
        operation = source_mark();
    .)
    "("
    ( IF(ForInAhead(Sym)) TableForIn<operation> | TableCountedFor<operation> )
  .

  /* One name binds the value; two bind key and value. Receiver evaluation still
   * precedes the shared lexical body scope, so outer names remain visible there. */
  TableForIn<SourceMark operation> =
    (.
        int key = 0;
        int value = 0;
        int table = 0;
        SourceIteration iteration;
        SourceMark keymark;
        SourceMark valuemark;
    .)
    Name<&key> (. keymark = source_mark(); .)
    (
        "," Name<&value> (. valuemark = source_mark(); .)
        | (.
            value = key;
            valuemark = keymark;
            key = -1;
        .)
    )
    "in" TableExpression<&table> ")"
    (.
        source_restore(operation);
        ++depth;
        iteration = source_iteration_begin(table);
    .)
    "{"
    (.
        capture();
        source_enter_scope();
        source_iteration_bind(iteration, key, value, keymark, valuemark);
    .)
    FlowBody
    "}"
    (.
        capture();
        source_leave_scope();
        source_restore(operation);
        source_iteration_end(iteration);
        --depth;
    .)
  .


  /* Counted headers own a loop-local scope. Numeric bodies nest one lexical
   * scope; table bodies preserve their established scope. Steps are staged. */
  TableCountedFor<SourceMark operation> =
    (.
        SourceFor control;
        SourceCondition condition;
        int has_condition = 0;
    .)
    (. source_enter_scope(); .)
    [ FlowForClause ] ";"
    (.
        source_restore(operation);
        control = source_for_begin();
    .)
    [ FlowCondition<&condition> (. has_condition = 1; .) ] ";"
    (.
        source_restore(operation);
        if (!has_condition)
        {
            condition = source_for_true();
        }
        ++depth;
        source_loop_condition(control.loop, condition);
        source_for_step_begin(control);
    .)
    [ FlowForClause ] ")"
    (. source_for_step_end(control); .)
    "{"
    (.
        if (!source_table_profile())
        {
            capture();
            source_enter_scope();
        }
    .)
    FlowBody
    "}"
    (.
        if (!source_table_profile())
        {
            capture();
            source_leave_scope();
        }
    .)
    (.
        source_restore(operation);
        source_for_end(control);
        source_leave_scope();
        --depth;
    .)
  .

  /* Numeric for has a counted header only; table snapshot iteration stays typed.
   * A consumed keyword guarantees progress at the shared parser depth limit. */
  NumericFor =
    IF(Sym==forSym && depth>=64) "for" (.
          capture();
          source_scope_limit();
      .)
    | IF(Sym==forSym && depth<64)
    (. SourceMark operation; .)
    "for"
    (.
        capture();
        operation = source_mark();
    .)
    "(" TableCountedFor<operation>
  .

  /* The immutable profile chooses one clause parser without rescanning input. */
  FlowForClause =
    IF(source_table_profile()) TableForClause
    | NumericBinding<0>
  .

  /* Ordinary lexical blocks share the parser's nesting budget and path state. */
  FlowBlock =
    IF(Sym==LbraceSym && depth>=64) "{"
    (.
        capture();
        source_scope_limit();
    .)
    | IF(Sym==LbraceSym && depth<64) "{"
    (.
        capture();
        ++depth;
        source_enter_scope();
    .)
    FlowBody
    "}"
    (.
        capture();
        source_leave_scope();
        --depth;
    .)
  .

  /* A transfer closes its path. No unreachable block is fabricated for suffixes. */
  FlowBody =
    IF(source_table_profile()) TableFlowBody
    | NumericFlowBody
  .

  /* Separate profile FIRST sets keep statement recovery bounded and consuming. */
  TableFlowBody =
    {
        (. source_statement(); .)
        ( FlowIf | FlowReturn | TableStatement )
    }
  .

  /* A numeric body admits scalar statements, while and structured transfers.
   * Unsupported statement starters remain outside this repetition's FIRST set. */
  NumericFlowBody =
    {
        (. source_statement(); .)
        ( FlowIf | FlowReturn | NumericStatement )
    }
  .

  /* Both scalar and table profiles use the same structured branch/loop helpers.
   * Arithmetic parsing remains profile-owned; no expression is parsed twice. */
  FlowCondition<SourceCondition *condition> =
    IF(source_table_profile()) TableCondition<condition>
    | LimboCondition<condition>
  .

  /* Numeric locals retain their existing strict initialized declaration syntax.
   * While and innermost transfers now share full function-level flow handling. */
  NumericStatement =
    LimboStatement
    | TableWhile
    | NumericFor
    | LoopTransfer
  .

  /* A source return exits the function; it is not a jump to a loop continuation. */
  FlowReturn =
    (.
        int value = 0;
        SourceMark operation;
    .)
    "return"
    (.
        capture();
        operation = source_mark();
    .)
    ( IF(source_table_profile()) TableExpression<&value> | Expression<&value> ) ";"
    (.
        source_restore(operation);
        source_flow_return(value);
    .)
  .

  /* Only the innermost active loop is targeted; named transfers are not added. */
  LoopTransfer =
    "break"
    (.
        capture();
        source_loop_transfer(0);
    .)
    ";"
    | "continue"
    (.
        capture();
        source_loop_transfer(1);
    .)
    ";"
  .

  /* Structured conditionals work at function/block/loop scope. Empty false arms
   * join normally; all-terminal choices keep their original two-block budget. */
  FlowIf =
    IF(Sym==ifSym && depth>=64) "if"
    (.
        capture();
        source_scope_limit();
    .)
    | IF(Sym==ifSym && depth<64)
    (.
        SourceChoice choice;
        SourceCondition condition;
        SourceMark operation;
    .)
    "if"
    (.
        capture();
        operation = source_mark();
        choice = source_choice_begin();
    .)
    "(" FlowCondition<&condition> ")"
    (.
        source_restore(operation);
        ++depth;
        source_choice_test(choice, condition);
    .)
    "{"
    (.
        capture();
        source_enter_scope();
    .)
    FlowBody
    "}"
    (.
        capture();
        source_leave_scope();
        source_restore(operation);
        source_choice_else(&choice);
    .)
    [ "else"
      (
          FlowIf
          | "{"
            (.
                capture();
                source_enter_scope();
            .)
            FlowBody
            "}"
            (.
                capture();
                source_leave_scope();
            .)
      )
    ]
    (.
        source_restore(operation);
        source_choice_end(choice);
        --depth;
    .)
  .

  /* Statement-only postfix updates share the captured assignment destination. */
  TableIncrementOperator<int *direction> =
    "++"
    (.
        capture();
        *direction = 1;
    .)
    | "--"
    (.
        capture();
        *direction = -1;
    .)
  .

  /* Operator spellings match Inferno compound arithmetic. The bounded table
   * profile keeps big arithmetic and explicit int shift counts, without **=. */
  TableAssignmentOperator<int *op> =
    ( "=" (. *op = 0; .)
      | "+=" (. *op = '+'; .)
      | "-=" (. *op = '-'; .)
      | "*=" (. *op = '*'; .)
      | "/=" (. *op = '/'; .)
      | "%=" (. *op = '%'; .)
      | "&=" (. *op = '&'; .)
      | "|=" (. *op = '|'; .)
      | "^=" (. *op = '^'; .)
      | "<<=" (. *op = '<'; .)
      | ">>=" (. *op = '>'; .)
    ) (. capture(); .)
  .

  /* Table values stay big. String locals may provide keys; key snapshots use type inference. */
  TableType<int *type> =
    "int" (. *type = T_I32; .)
    | "big" (. *type = T_I64; .)
    | "string" (. *type = T_STRING; .)
    | "table" "of" "big" (. *type = T_TABLE_BIG; .)
    | ident (. capture(); *type = source_table_alias(); .)
  .

  /* Assignment-only selector. Range bounds run once and are captured before RHS.
   * Both bounds are explicit in this initial executable profile. */
  TableWriteKey<int *key, int *end, int *slice, SourceMark *access> =
    (. *slice = 0; .)
    (
        "." (ident | "value" | "type") (. capture(); *access = source_mark(); *key = source_table_text(0); .)
        | "[" (. capture(); *access = source_mark(); .) TableExpression<key>
          [ ":" TableExpression<end> (. *slice = 1; .) ] "]"
    )
  .

  /* Dotted identifiers are literal string keys, not lookups of a local binding with that name. */
  TableKey<int *key> =
    "." (ident | "value" | "type") (. capture(); *key = source_table_text(0); .)
    | "[" TableExpression<key> "]"
  .

  /* Deletion captures a receiver/key once and never reads a missing value. */
  TableDelete<int *result> =
    (. int name = 0, key = 0, slot = 0; SourceMark operation; .)
    "delete" (. capture(); operation = source_mark(); .)
    Name<&name> (. slot = source_read(name); .) TableKey<&key>
    (. slot = source_table_index(slot, key); source_restore(operation);
       *result = source_table_delete(slot); .)
  .

  /* Logical operators match Inferno: && binds more tightly than ||. RHS code
   * is emitted only inside its guarded CFG arm, never eagerly before a branch. */
  TableExpression<int *result> =
    (.
        int right = 0;
        SourceLogic logic;
        SourceMark operation;
    .)
    TableLogicalAnd<result>
    {
        "||" (. capture(); operation = source_mark(); logic = source_logic_begin(*result, 1); .)
        TableLogicalAnd<&right>
        (. source_restore(operation); *result = source_logic_end(logic, right); .)
    }
  .

  /* Every && RHS begins after its own control-flow edge and shares the block budget. */
  TableLogicalAnd<int *result> =
    (.
        int right = 0;
        SourceLogic logic;
        SourceMark operation;
    .)
    TableMembership<result>
    {
        "&&" (. capture(); operation = source_mark(); logic = source_logic_begin(*result, 0); .)
        TableMembership<&right>
        (. source_restore(operation); *result = source_logic_end(logic, right); .)
    }
  .

  /* Membership binds below bitwise OR and above the logical operators. */
  TableMembership<int *result> =
    (. int table = 0; SourceMark operation; .)
    TableBitOr<result>
    [ "in" (. capture(); operation = source_mark(); .) TableBitOr<&table>
      (. source_restore(operation); *result = source_table_has(table, *result); .)
    ]
  .

  /* Bitwise OR is weakest numeric level; each level associates left. */
  TableBitOr<int *result> =
    (. int right = 0;
       SourceMark operation;
    .)
    TableBitXor<result>
    {
        "|" (. capture(); operation = source_mark(); .) TableBitXor<&right>
        (. source_restore(operation); *result = source_table_binary(*result, right, '|'); .)
    }
  .

  /* XOR binds more tightly than OR and less tightly than AND. */
  TableBitXor<int *result> =
    (. int right = 0;
       SourceMark operation;
    .)
    TableBitAnd<result>
    {
        "^" (. capture(); operation = source_mark(); .) TableBitAnd<&right>
        (. source_restore(operation); *result = source_table_binary(*result, right, '^'); .)
    }
  .

  /* AND binds more tightly than the other bitwise operators, below arithmetic sums. */
  TableBitAnd<int *result> =
    (. int right = 0;
       SourceMark operation;
    .)
    TableEquality<result>
    {
        "&" (. capture(); operation = source_mark(); .) TableEquality<&right>
        (. source_restore(operation); *result = source_table_binary(*result, right, '&'); .)
    }
  .

  /* Inferno limbo.y places equality below ordering and above bitwise AND.
   * Comparisons are values, evaluated once left-to-right. Static types reject
   * mixed numeric operands and ordered bools rather than inventing coercions. */
  TableEquality<int *result> =
    (.
        int right = 0;
        SourceRelation relation = SOURCE_EQUAL;
        SourceMark operation;
    .)
    TableOrdering<result>
    {
        ( "==" (. relation = SOURCE_EQUAL; .)
          | "!=" (. relation = SOURCE_NOT_EQUAL; .)
        ) (. capture(); operation = source_mark(); .)
        TableOrdering<&right>
        (. source_restore(operation); *result = source_table_relation(*result, right, relation); .)
    }
  .

  /* Ordering binds below shifts and above equality, matching the owning Limbo grammar. */
  TableOrdering<int *result> =
    (.
        int right = 0;
        SourceRelation relation = SOURCE_EQUAL;
        SourceMark operation;
    .)
    TableShift<result>
    {
        ( "<" (. relation = SOURCE_LESS; .)
          | ">" (. relation = SOURCE_GREATER; .)
          | "<=" (. relation = SOURCE_LESS_EQUAL; .)
          | ">=" (. relation = SOURCE_GREATER_EQUAL; .)
        ) (. capture(); operation = source_mark(); .)
        TableShift<&right>
        (. source_restore(operation); *result = source_table_relation(*result, right, relation); .)
    }
  .

  /* Limbo shifts bind below sums and above bitwise AND; counts require explicit int values. */
  TableShift<int *result> =
    (. int right = 0;
       int direction = 0;
       SourceMark operation;
    .)
    TableSum<result>
    {
        ( "<<" (. capture(); operation = source_mark(); direction = '<'; .)
          | ">>" (. capture(); operation = source_mark(); direction = '>'; .)
        )
        TableSum<&right>
        (. source_restore(operation); *result = source_table_shift(*result, right, direction); .)
    }
  .

  /* Big sums associate left; products bind more tightly than addition/subtraction. */
  TableSum<int *result> =
    (. int right = 0;
       int op = 0;
       SourceMark operation;
    .)
    TableProduct<result>
    {
        ( "+" (. capture(); operation = source_mark(); op = '+'; .)
          | "-" (. capture(); operation = source_mark(); op = '-'; .)
        )
        TableProduct<&right>
        (. source_restore(operation); *result = source_table_binary(*result, right, op); .)
    }
  .

  /* Multiplication, division and remainder associate left at the same precedence. */
  TableProduct<int *result> =
    (. int right = 0;
       int op = 0;
       SourceMark operation;
    .)
    TableUnary<result>
    {
        ( "*" (. capture(); operation = source_mark(); op = '*'; .)
          | "/" (. capture(); operation = source_mark(); op = '/'; .)
          | "%" (. capture(); operation = source_mark(); op = '%'; .)
        )
        TableUnary<&right>
        (. source_restore(operation); *result = source_table_binary(*result, right, op); .)
    }
  .

  /* Every group, prefix and nested index goes through this shared depth boundary.
   * The recovery alternative consumes a token and records a resource diagnostic. */
  TableUnary<int *result> =
    IF(depth < 64) (. ++depth; .)
    TablePrefix<result> (. --depth; .)
    | IF(depth >= 64) ident (. source_scope_limit(); *result = 0; .)
  .

  /* Constructors lower directly to existing new/index/store FIR. Positional
   * numbering starts at zero and advances only for positional fields. Each
   * captured location is checked before its value expression is parsed. */
  TableConstructor<int *result> =
    (. int position = 0; .)
    "table" (. capture(); .) "of" "big" (. *result = source_table_new(); .)
    [ "{"
      [ TableField<*result,&position>
        { IF(Sym==CommaSym && MoreFieldsAhead()) "," TableField<*result,&position> }
        [ "," ]
      ]
      "}"
    ]
  .

  /* Key expressions run once, then location validation precedes the RHS.
   * Bare names become copied string keys; bracket keys retain their exact type.
   * The parser restores each key origin when publishing the final store. */
  TableField<int owner, int *position> =
    (.
        int key = 0;
        int slot = 0;
        int value = 0;
        SourceMark origin;
    .)
    (
        IF((Sym==identSym || Sym==valueSym || Sym==typeSym) && NamedFieldAhead())
        (ident | "value" | "type") (. capture(); origin = source_mark(); key = source_table_text(0);
                 slot = source_table_index(owner, key); .)
        "=" TableExpression<&value>
        | "[" (. capture(); origin = source_mark(); .)
          TableExpression<&key> "]"
          (. source_restore(origin); slot = source_table_index(owner, key); .)
          "=" TableExpression<&value>
        | IF(!((Sym==identSym || Sym==valueSym || Sym==typeSym) && NamedFieldAhead()))
          (.
              source_token("", S_NextLine, S_NextPos, (size_t)S_NextLen, 0);
              origin = source_mark();
              key = source_table_position((*position)++);
              slot = source_table_index(owner, key);
          .)
          TableExpression<&value>
    )
    (. source_restore(origin); source_table_store(slot, value); .)
  .

  /* Numeric literals are exact big constants. Limbo big/string casts and typeof
   * retain their own operator span while recursively parsing a bounded operand. */
  TablePrefix<int *result> =
    (. int name = 0;
       int key = 0;
       int end = 0;
       int slice = 0;
       SourceMark operation;
       SourceMark literal;
       SourceMark access;
       FirType cast = T_VOID;
    .)
    (
        IF(Sym==MinusSym && LiteralAhead()) "-" (. capture(); operation = source_mark(); .)
        numeral
          (. capture();
             literal = source_mark();
             operation.length = (size_t)(literal.offset - operation.offset) + literal.length;
             source_restore(operation);
             *result = source_table_constant(1);
          .)
        | "-" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_unary(*result, '-'); .)
        | "+" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_unary(*result, '+'); .)
        | "~" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_unary(*result, '~'); .)
        | "!" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_not(*result); .)
        | TableDelete<result>
        | "countof" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_count(*result); .)
        | "len" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_len(*result); .)
        /* Prefer a catalog type name to a value expression; no local may shadow it. */
        | IF(Sym==identSym && AliasAhead())
          ident
          (.
              capture();
              operation = source_mark();
              cast = source_alias_type();
          .)
          TableUnary<result>
          (.
              source_restore(operation);
              *result = source_alias_cast(*result, cast);
          .)
        | "int" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_convert(*result, 2); .)
        | "big" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_convert(*result, 0); .)
        | "string" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_convert(*result, 1); .)
        | "typeof" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_typeof(*result); .)
        | "keysof" (. capture(); operation = source_mark(); .) TableUnary<result>
          (. source_restore(operation); *result = source_table_keys(*result); .)
        | (
            Name<&name> (. *result = source_read(name); .)
            | TableConstructor<result>
            | textlit (. capture(); *result = source_table_text(1); .)
            | numeral
              (. capture(); *result = source_table_constant(0); .)
            | "(" TableExpression<result> ")"
          )
          {
              "." (ident | "value" | "type") (. capture(); key = source_table_text(0);
                            *result = source_table_load(source_table_index(*result, key)); .)
              | "[" (. capture(); access = source_mark(); .) TableExpression<&key>
                (. slice = 0; .)
                [ ":" TableExpression<&end> (. slice = 1; .) ] "]"
                (. source_restore(access);
                   *result = slice ? source_table_slice(*result, key, end)
                                  : source_table_subscript(*result, key); .)
          }
    )
  .

END
  Src1
  .

