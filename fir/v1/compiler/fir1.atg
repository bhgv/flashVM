/* Authoritative FIR 1.0 scanner/parser, generated by bhgv/coco-r-C.
 * No parser code is checked in. Semantic actions build C99 IR through builder.h.
 * Each production/token has a comment; unsupported operations have no fallback. */
COMPILER Fir1
#include "builder.h"
/* Capture a consumed token, never a lookahead. Reject before truncation.
 * Quoted token spelling is decoded by the semantic builder. */
static void capture(int role)
{
    char text[FIR_TEXT];
    if (S_Len >= FIR_TEXT)
    {
        fir_build_error("token exceeds 255 bytes", S_Line);
        return;
    }
    S_GetString(S_Pos, S_Len, text, FIR_TEXT - 1);
    fir_build_token(role, text, S_Line);
}

CHARACTERS
  /* ASCII identifiers keep emitted symbol names portable. */
  letter =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"
  .

  /* Decimal digits for integer and floating-point constants. */
  digit =
    "0123456789"
  .

  /* Hexadecimal constant digits. */
  hex =
    digit + "abcdefABCDEF"
  .

  /* Bytes inside UTF-8 strings, excluding quote, escape, NUL and newlines. */
  quotedbyte =
    ANY - '"' - "\\" - CHR(0) - CHR(10) - CHR(13)
  .

  /* Only these escape letters have FIR 1.0 meanings. */
  escaped =
    '"' + "\\nrt"
  .

  /* Complete line comment, possibly ending at EOF. */
  linebyte =
    ANY - CHR(0) - CHR(10) - CHR(13)
  .

  /* Block-comment components ensure a closing delimiter is mandatory. */
  nonstar =
    ANY - "*" - CHR(0)
  .

  nonstarslash =
    ANY - "*" - "/" - CHR(0)
  .

TOKENS
  /* SSA value, global symbol and basic-block label. */
  value =
    "%" letter
    {
        letter
        | digit
        | "."
    }
  .

  global =
    "@" letter
    {
        letter
        | digit
        | "."
    }
  .

  label =
    "^" letter
    {
        letter
        | digit
        | "."
    }
  .

  /* One decimal numeric token; semantic actions distinguish i32/f64 ranges. */
  number =
    [
        "+"
        | "-"
    ]
    (
        digit
        {
            digit
        }
        [
            "."
            {
                digit
            }
        ]
        | "." digit
        {
            digit
        }
    )
    [
        (
            "e"
            | "E"
        )
        [
            "+"
            | "-"
        ]
        digit
        {
            digit
        }
    ]
  .

  /* Explicit hexadecimal spelling; overflow is checked by the C99 builder. */
  hexnum =
    [
        "+"
        | "-"
    ]
    "0"
    (
        "x"
        | "X"
    )
    hex
    {
        hex
    }
  .

  /* UTF-8 string; byte validity is checked before the generated scanner. */
  textlit =
    '"'
    {
        quotedbyte
        | "\\" escaped
    }
    '"'
  .

PRAGMAS
  /* Comments do not enter IR and are regenerated as source-line notes. */
  linecomment =
    "//"
    {
        linebyte
    }
  .

  /* Non-nesting C-style comments, with a required terminator. */
  blockcomment =
    "/*"
    {
        nonstar
        | "*"
        {
            "*"
        }
        nonstarslash
    }
    "*"
    {
        "*"
    }
    "/"
  .

IGNORE
  CHR(9) + CHR(10) + CHR(13)

PRODUCTIONS
  /* Version spelling is fixed; the driver also enforces physical first line. */
  Fir1 =
    "FIR" number                                                        (. capture(B_VERSION); .)
    "module" global                                                     (. capture(B_MODULE); .)
    [
        "source_language"
        (
            "as1"
            | "as2"
            | "as3"
            | "limbo"
        )
                                                                        (. capture(B_LANGUAGE); .)
        "source_semantics"
        (
            "avm1_numeric"
            | "limbo_i32"
            | "limbo_real"
            | "limbo_tables"
        )
                                                                        (. capture(B_SEMANTICS); .)
    ]
    [
        "requires" "flashvm.channels"                                   (. fir_build_channels(); .)
    ]
    "func" global                                                       (. capture(B_FUNCTION); .)
    "(" ")" "->" "void" "{" Block
    {
        Block
    }
    "}" EOF
  .

  /* A block owns all instructions up to the next label or closing brace. */
  Block =
    label                                                               (. capture(B_BLOCK); .)
    ":"
    {
        Instruction
    }
  .

  /* Each instruction starts a fresh bounded semantic-builder record. */
  Instruction =
                                                                        (. fir_build_begin(S_NextLine); .)
    (
        Result
        | Effect
    )
                                                                        (. fir_build_end(); .)
  .

  /* Typed SSA definition; definitions and operand dominance are verified later. */
  Result =
    value                                                               (. capture(B_RESULT); .)
    ":" Type "=" ValueOperation
  .

  /* Every supported type is explicit; future names are rejected. */
  Type =
    (
        "i32"
        | "f64"
        | "bool"
        | "string"
        | "any"
        | "channel"
        | "i64"
        | "table.big"
        | "table.slot"
        | "big.range"
        | "keys"
        | "table.key"
        | "bool.slot"
    )
                                                                        (. capture(B_TYPE); .)
  .

  /* Constants, pure operations and effectful value producers. */
  ValueOperation =
    "bool.local" (. fir_build_op(O_BOOL_LOCAL); .)
    | "bool.load" (. fir_build_op(O_BOOL_LOAD); .) A
    | "const.i64" (. fir_build_op(O_I64); .) number (. capture(B_LITERAL); .)
    | "table.new" (. fir_build_op(O_TABLE_NEW); .)
    | "table.index" (. fir_build_op(O_TABLE_INDEX); .) A "," B
    | "table.load" (. fir_build_op(O_TABLE_LOAD); .) A
    | "table.count" (. fir_build_op(O_TABLE_COUNT); .) A
    | "table.has" (. fir_build_op(O_TABLE_HAS); .) A
    | "table.delete" (. fir_build_op(O_TABLE_DELETE); .) A
    | "table.len" (. fir_build_op(O_TABLE_LEN); .) A
    | "range.big" (. fir_build_op(O_BIG_RANGE); .) A "," B
    | "table.slice" (. fir_build_op(O_TABLE_SLICE); .) A "," B
    | "table.keys" (. fir_build_op(O_TABLE_KEYS); .) A
    | "big.add" (. fir_build_op(O_BIG_ADD); .) A "," B
    | "big.sub" (. fir_build_op(O_BIG_SUB); .) A "," B
    | "big.mul" (. fir_build_op(O_BIG_MUL); .) A "," B
    | "big.div" (. fir_build_op(O_BIG_DIV); .) A "," B
    | "big.mod" (. fir_build_op(O_BIG_MOD); .) A "," B
    | "big.and" (. fir_build_op(O_BIG_AND); .) A "," B
    | "big.or" (. fir_build_op(O_BIG_OR); .) A "," B
    | "big.xor" (. fir_build_op(O_BIG_XOR); .) A "," B
    | "big.lt.signed" (. fir_build_op(O_BIG_LT); .) A "," B
    | "big.eq" (. fir_build_op(O_BIG_EQ); .) A "," B
    | "value.int" (. fir_build_op(O_TO_INT); .) A
    | "big.shl" (. fir_build_op(O_BIG_SHL); .) A "," B
    | "big.shr" (. fir_build_op(O_BIG_SHR); .) A "," B
    | "big.not" (. fir_build_op(O_BIG_NOT); .) A
    | "big.neg" (. fir_build_op(O_BIG_NEG); .) A
    | "value.big" (. fir_build_op(O_TO_BIG); .) A
    | "value.text" (. fir_build_op(O_TO_TEXT); .) A
    | "value.type" (. fir_build_op(O_VALUE_TYPE); .) A
    | "keys.at" (. fir_build_op(O_KEYS_AT); .) A "," B
    | "keys.len" (. fir_build_op(O_KEYS_LEN); .) A
    | "const.i32"                                                         (. fir_build_op(O_I32); .)
    (
        number
        | hexnum
    )
                                                                        (. capture(B_LITERAL); .)
    | "const.f64"                                                       (. fir_build_op(O_F64); .)
    (
        number
        | hexnum
    )
                                                                        (. capture(B_LITERAL); .)
    | "const.bool"                                                      (. fir_build_op(O_BOOL); .)
    (
        "true"
        | "false"
    )
                                                                        (. capture(B_LITERAL); .)
    | "const.string"                                                    (. fir_build_op(O_STRING); .)
    textlit                                                             (. capture(B_LITERAL); .)
    | "copy"                                                            (. fir_build_op(O_COPY); .)
    A
    | IntegerBinary A "," B
    | FloatingBinary A "," B
    | "as.add"                                                          (. fir_build_op(O_ASADD); .)
    A "," B
    | "as.to_number"                                                    (. fir_build_op(O_NUMBER); .)
    A
    | "limbo.chan_create"                                               (. fir_build_op(O_CHANNEL); .)
    | "limbo.chan_receive"                                              (. fir_build_op(O_RECEIVE); .)
    A
  .

  /* Fixed-width arithmetic specifies wrap explicitly, comparisons return bool. */
  IntegerBinary =
    "i32.add.wrap"                                                      (. fir_build_op(O_ADD); .)
    | "i32.sub.wrap"                                                    (. fir_build_op(O_SUB); .)
    | "i32.mul.wrap"                                                    (. fir_build_op(O_MUL); .)
    | "i32.lt.signed"                                                   (. fir_build_op(O_LT); .)
    | "i32.eq"                                                          (. fir_build_op(O_EQ); .)
  .

  /* Strict floating operations: no fast-math rewrites. */
  FloatingBinary =
    "f64.add"                                                           (. fir_build_op(O_FADD); .)
    | "f64.sub"                                                         (. fir_build_op(O_FSUB); .)
    | "f64.mul"                                                         (. fir_build_op(O_FMUL); .)
    | "f64.div"                                                         (. fir_build_op(O_FDIV); .)
  .

  /* First operand role. */
  A =
    value                                                               (. capture(B_A); .)
  .

  /* Second operand role. */
  B =
    value                                                               (. capture(B_B); .)
  .

  /* Statements without SSA results; if has true target followed by false target. */
  Effect =
    "bool.store" (. fir_build_op(O_BOOL_STORE); .) A "," B
    | "table.store" (. fir_build_op(O_TABLE_STORE); .) A "," B
    | "trace"                                                             (. fir_build_op(O_TRACE); .)
    A
    | "limbo.chan_send"                                                 (. fir_build_op(O_SEND); .)
    A "," B
    | "limbo.chan_close"                                                (. fir_build_op(O_CLOSE); .)
    A
    | "if"                                                              (. fir_build_op(O_IF); .)
    A "," label                                                         (. capture(B_YES); .)
    "," label                                                           (. capture(B_NO); .)
    | "jump"                                                            (. fir_build_op(O_JUMP); .)
    label                                                               (. capture(B_YES); .)
    | "return"                                                          (. fir_build_op(O_RETURN); .)
  .

END
  Fir1
  .

