/* Cairo image/recording/user-font core; PNG and SVG follow IMAGE_CODECS.
 * FreeType faces follow FONTS; native font discovery, PDF and display backends
 * are disabled. Platform locking
 * remains enabled. */
#ifndef FVM_CAIRO_CONFIG_H
#define FVM_CAIRO_CONFIG_H
#ifndef _GNU_SOURCE
#define _GNU_SOURCE 1
#endif
#ifndef _POSIX_C_SOURCE
#define _POSIX_C_SOURCE 200809L
#endif
/* FreeType APIs present in the pinned 2.14.3 distribution. */
#define HAVE_FT_GLYPHSLOT_EMBOLDEN 1
#define HAVE_FT_GLYPHSLOT_OBLIQUE 1
#define HAVE_FT_LIBRARY_SETLCDFILTER 1
#define HAVE_FT_GET_VAR_DESIGN_COORDINATES 1
#define HAVE_FT_LOAD_SFNT_TABLE 1
#define HAVE_FT_DONE_MM_VAR 1
#define HAVE_FT_GET_X11_FONT_FORMAT 1
#define HAVE_STDINT_H 1
#define HAVE_UINT64_T 1
#define CAIRO_HAS_PTHREAD @FVM_VENDOR_PTHREAD@
#define SIZEOF_VOID_P @CMAKE_SIZEOF_VOID_P@
#define SIZEOF_INT 4
#define SIZEOF_LONG @FVM_VENDOR_SIZEOF_LONG@
#define PACKAGE_VERSION "1.16.0"
#cmakedefine FVM_VENDOR_BIG_ENDIAN 1
#ifdef FVM_VENDOR_BIG_ENDIAN
#define WORDS_BIGENDIAN 1
#endif
#ifndef _WIN32
#define HAVE_STRNDUP 1
#define HAVE_STRDUP 1
#define HAVE_STRERROR 1
#endif
#endif
