+/* FlashVM: reentrant tokenization using only ANSI C string operations. */
+static char *gif_token(char *text, const char *delimiters, char **state) {
+    char *end;
+    if (text == NULL) text = *state;
+    text += strspn(text, delimiters);
+    if (*text == '\0') { *state = text; return NULL; }
+    end = text + strcspn(text, delimiters);
+    if (*end != '\0') *end++ = '\0';
+    *state = end;
+    return text;
+}
