// Neutral grey desk, independent of Flash timeline frames.
// Executed AS -> FIR -> SWO -> SWF actions. ideDraw is an owner-local generic
// drawing capability; Dis owns geometry/selection and no heap pointer crosses it.
ideDraw.clear = true;
// Desk gradient band 1.
ideDraw.x = 0;
ideDraw.y = chromeHeight * 0 / 8;
ideDraw.w = chromeWidth;
ideDraw.h = chromeHeight / 8;
ideDraw.color = 5462620;
ideDraw.alpha = 100;
ideDraw.rect = true;
