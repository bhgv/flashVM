implement Idebuiltins;
include "idecomplete.m";
include "idebuiltins.m";


# Build one fresh provider item. Text/parameters are owned values; returns an independent record.
item(name: string, kind: int, signature, documentation: string,
     parameters: array of ref Idecomplete->Parameter): ref Idecomplete->Item
{
    return ref Idecomplete->Item(name, kind, signature, documentation, parameters);
}


# Build structured short argument help. All fields are copied values; returns a fresh descriptor.
parameter(name, type_name: string, optional: int, summary: string): ref Idecomplete->Parameter
{
    return ref Idecomplete->Parameter(name, type_name, optional, summary);
}


