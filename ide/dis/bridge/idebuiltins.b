# Produce overload-aware parameter help from an admitted bounded candidate result.
# candidates/name/argument and copy/result semantics follow idebuiltins.m.
help(candidates: array of ref Idecomplete->Item, name: string,
     argument: int): array of ref Calltip
{
    if (len candidates > Idecomplete->MaxResults || argument < 0 || argument > 1024) {
        return nil;
    }
    count := 0;
    for (i := 0; i < len candidates; i++) {
        if (candidates[i] != nil && candidates[i].name == name) {
            count++;
        }
    }
    result := array[count] of ref Calltip;
    next := 0;
    for (i = 0; i < len candidates; i++) {
        candidate := candidates[i];
        if (candidate == nil || candidate.name != name) {
            continue;
        }
        active := argument;
        selected: ref Idecomplete->Parameter;
        parameters := candidate.parameters;
        if (active >= len parameters) {
            active = -1;
            if (len parameters > 0) {
                last := parameters[len parameters - 1];
                if (last != nil && len last.name >= 3 && last.name[0:3] == "...") {
                    active = len parameters - 1;
                }
            }
        }
        if (active >= 0 && parameters[active] != nil) {
            p := parameters[active];
            selected = ref Idecomplete->Parameter(p.name, p.type_name, p.optional, p.summary);
        } else {
            active = -1;
        }
        result[next] = ref Calltip(candidate.name, candidate.signature,
            candidate.documentation, active, selected);
        next++;
    }
    return result;
}
