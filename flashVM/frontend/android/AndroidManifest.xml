<?xml version="1.0" encoding="utf-8"?>
<!-- Test-only ARM64 application: no external storage, microphone or network permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.bhgv.flashvm">
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="35" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="FlashVM" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Use SDL's blocking AudioTrack bridge: SDL 2.30.0 AAudio drops partial writes. -->
        <meta-data android:name="SDL_ENV.SDL_AUDIODRIVER" android:value="android" />
        <provider android:name=".DiagnosticProvider" android:authorities="org.bhgv.flashvm.diagnostics"
            android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".MenuActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PlayerActivity" android:exported="false" android:process=":player"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density">
            <!-- Separate process gives every SDL test a clean native/Java lifecycle. -->
        </activity>
    </application>
</manifest>
