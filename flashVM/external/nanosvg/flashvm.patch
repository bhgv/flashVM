 // We roll our own string to float because the std library one uses locale and messes things up.
+/* FlashVM: locale-independent C89 decimal accumulation avoids long long
+ * and C99 strtoll, including on 32-bit targets. */
+static double nsvg__decimalPart(const char* s, char** end)
+{
+    double value = 0.0;
+    while (nsvg__isdigit(*s)) {
+        value = value * 10.0 + (*s - '0');
+        ++s;
+    }
+    *end = (char*)s;
+    return value;
+}
