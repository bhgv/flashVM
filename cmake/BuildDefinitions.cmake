# DEFS.txt is authoritative. A separate file can be selected for CI/cross builds.
set(FVM_DEFS_FILE "${PROJECT_SOURCE_DIR}/DEFS.txt" CACHE FILEPATH "FlashVM build-key file")
if(NOT EXISTS "${FVM_DEFS_FILE}")
  message(FATAL_ERROR "Build definitions file does not exist: ${FVM_DEFS_FILE}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${FVM_DEFS_FILE}")
set(FVM_GROUP_GRAPHICS GRAPHICS_AGG GRAPHICS_CAIRO NO_GRAPHICS)
set(FVM_GROUP_PLATFORM AUTO_PLATFORM WINDOWS LINUX MAC ANDROID)
set(FVM_GROUP_OUTPUT HEADLESS FB GLES OGL DX SDL1 SDL2 SDL3)
set(FVM_GROUP_SQLITE SQLITE NO_SQLITE)
set(FVM_GROUP_OS OS_PORTS NO_OS_PORTS)
set(FVM_GROUP_JOBS RENDER_JOBS NO_RENDER_JOBS)
set(FVM_GROUP_EXECUTION INTERPRETER JIT)
set(FVM_GROUP_MEDIA NO_MEDIA MEDIA)
set(FVM_GROUPS GRAPHICS PLATFORM OUTPUT SQLITE OS JOBS EXECUTION MEDIA)
set(FVM_KNOWN_KEYS)
foreach(group ${FVM_GROUPS})
  list(APPEND FVM_KNOWN_KEYS ${FVM_GROUP_${group}})
endforeach()
file(STRINGS "${FVM_DEFS_FILE}" lines ENCODING UTF-8)
set(FVM_BUILD_KEYS)
foreach(line ${lines})
  string(REGEX REPLACE "#.*$" "" key "${line}")
  string(STRIP "${key}" key)
  if(key STREQUAL "")
    continue()
  endif()
  list(FIND FVM_KNOWN_KEYS "${key}" known)
  if(known EQUAL -1)
    message(FATAL_ERROR "Unknown DEFS.txt key: ${key}")
  endif()
  list(FIND FVM_BUILD_KEYS "${key}" duplicate)
  if(NOT duplicate EQUAL -1)
    message(FATAL_ERROR "Duplicate DEFS.txt key: ${key}")
  endif()
  list(APPEND FVM_BUILD_KEYS "${key}")
endforeach()
foreach(group ${FVM_GROUPS})
  set(selected)
  foreach(key ${FVM_GROUP_${group}})
    if(key IN_LIST FVM_BUILD_KEYS)
      list(APPEND selected ${key})
    endif()
  endforeach()
  list(LENGTH selected count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "DEFS.txt group ${group} requires exactly one key; selected: ${selected}")
  endif()
  set(FVM_SELECTED_${group} "${selected}")
endforeach()
if(NOT FVM_SELECTED_OUTPUT STREQUAL "HEADLESS")
  message(FATAL_ERROR "Presentation adapter ${FVM_SELECTED_OUTPUT} is not implemented; use HEADLESS")
endif()
if(FVM_SELECTED_EXECUTION STREQUAL "JIT" OR FVM_SELECTED_MEDIA STREQUAL "MEDIA")
  message(FATAL_ERROR "JIT and media backends are not implemented; DEFS.txt cannot enable them")
endif()
if(WIN32)
  set(FVM_PORT windows)
  set(FVM_PLATFORM_KEY WINDOWS)
elseif(ANDROID)
  set(FVM_PORT android)
  set(FVM_PLATFORM_KEY ANDROID)
elseif(APPLE)
  set(FVM_PORT mac)
  set(FVM_PLATFORM_KEY MAC)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(FVM_PORT linux)
  set(FVM_PLATFORM_KEY LINUX)
else()
  message(FATAL_ERROR "No thread/channel port for target ${CMAKE_SYSTEM_NAME}")
endif()
if(NOT FVM_SELECTED_PLATFORM STREQUAL "AUTO_PLATFORM" AND
   NOT FVM_SELECTED_PLATFORM STREQUAL FVM_PLATFORM_KEY)
  message(FATAL_ERROR "DEFS.txt platform ${FVM_SELECTED_PLATFORM} conflicts with target ${FVM_PLATFORM_KEY}; select a matching toolchain")
endif()
if(FVM_SELECTED_PLATFORM STREQUAL "AUTO_PLATFORM")
  list(APPEND FVM_BUILD_KEYS ${FVM_PLATFORM_KEY})
endif()
# Old cache switches may not silently override the file. Matching values work.
function(fvm_build_switch name enabled_key)
  set(value OFF)
  if(enabled_key IN_LIST FVM_BUILD_KEYS)
    set(value ON)
  endif()
  if(DEFINED ${name})
    if((${name} AND NOT value) OR (NOT ${name} AND value))
      message(FATAL_ERROR "${name} conflicts with DEFS.txt; edit DEFS.txt or use FVM_DEFS_FILE")
    endif()
  endif()
  set(${name} ${value} PARENT_SCOPE)
endfunction()
fvm_build_switch(FVM_ENABLE_AGG GRAPHICS_AGG)
fvm_build_switch(FVM_ENABLE_CAIRO GRAPHICS_CAIRO)
fvm_build_switch(FVM_ENABLE_SQLITE SQLITE)
fvm_build_switch(FVM_ENABLE_OS_PORTS OS_PORTS)
fvm_build_switch(FVM_ENABLE_RENDER_JOBS RENDER_JOBS)
fvm_build_switch(FVM_ENABLE_JIT JIT)
fvm_build_switch(FVM_ENABLE_MEDIA MEDIA)
set(FVM_GENERATED_INCLUDE "${PROJECT_BINARY_DIR}/generated")
file(MAKE_DIRECTORY "${FVM_GENERATED_INCLUDE}")
set(header "/* Generated from DEFS.txt. Do not edit. */\n#ifndef FVM_BUILD_CONFIG_H\n#define FVM_BUILD_CONFIG_H\n")
foreach(key ${FVM_BUILD_KEYS})
  string(APPEND header "#define ${key} 1\n")
endforeach()
string(APPEND header "#endif\n")
file(WRITE "${FVM_GENERATED_INCLUDE}/flashvm_build_config.h" "${header}")
message(STATUS "FlashVM definitions: ${FVM_BUILD_KEYS}")
